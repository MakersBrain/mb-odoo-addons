# Copy to .env and adjust. Nothing here is a secret; `.env` itself is gitignored
# because that is where a real credential would end up if anyone added one.
#
#   cp .env.example .env

# Odoo major version tag. The addons declare 19.0.x versions and use Odoo 19
# extension points, so moving this backwards will not work.
ODOO_VERSION=19

# Host ports.
#
# Deliberately not the conventional 8069/5432, so the stack can coexist with
# other local Odoo and Postgres services. Change them if those ports are free.
ODOO_PORT=8169
ODOO_GEVENT_PORT=8175
DB_PORT=5442

# Postgres credentials for the local container. These must match db_user and
# db_password in config/odoo.conf, which wins over the environment because the
# image entrypoint reads the config file first.
DB_USER=odoo
DB_PASSWORD=odoo

# The database `make install`, `make upgrade` and `make shell` act on.
DB_NAME=mb_odoo

# The only database `make reset-test-db` will ever drop. See the target's comment:
# it refuses anything else by design, so a demonstration database cannot be
# destroyed by a mistyped variable.
DISPOSABLE_DB=mb_scratch

# Mailpit, started only with `make mail`.
MAILPIT_UI_PORT=8125
MAILPIT_SMTP_PORT=1125
