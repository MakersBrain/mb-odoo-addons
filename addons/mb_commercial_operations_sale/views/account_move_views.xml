<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_move_form_commercial_operation" model="ir.ui.view">
    <field name="name">account.move.form.commercial.operation</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='invoice_origin']" position="after">
        <field name="mb_commercial_operation_id" readonly="state != 'draft'"/>
      </xpath>
    </field>
  </record>
</odoo>
