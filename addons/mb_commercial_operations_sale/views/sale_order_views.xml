<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_order_form_commercial_operation" model="ir.ui.view">
    <field name="name">sale.order.form.commercial.operation</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='client_order_ref']" position="after">
        <field name="mb_commercial_operation_id" readonly="state not in ('draft', 'sent')"/>
        <field name="mb_market_product_ids" invisible="1"/>
      </xpath>
      <xpath expr="//field[@name='order_line']/list/field[@name='product_template_id']" position="before">
        <field name="mb_commercial_operation_id" column_invisible="True"/>
        <field name="mb_market_product_ids" column_invisible="True"/>
      </xpath>
    </field>
  </record>
</odoo>
