<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_pos_order_form_commercial_operation" model="ir.ui.view">
    <field name="name">pos.order.form.commercial.operation</field>
    <field name="model">pos.order</field>
    <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='session_id']" position="after">
        <field name="mb_commercial_operation_id" readonly="1"/>
      </xpath>
    </field>
  </record>

  <record id="view_pos_session_form_commercial_operation" model="ir.ui.view">
    <field name="name">pos.session.form.commercial.operation</field>
    <field name="model">pos.session</field>
    <field name="inherit_id" ref="point_of_sale.view_pos_session_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='config_id']" position="after">
        <field name="mb_commercial_operation_id" readonly="1"/>
      </xpath>
    </field>
  </record>
</odoo>
