<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="project_project_view_form_commercial" model="ir.ui.view">
    <field name="name">project.project.form.commercial.operations</field>
    <field name="model">project.project</field>
    <field name="inherit_id" ref="project.edit_project"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='partner_id']" position="after">
        <field name="mb_commercial_kind" invisible="not mb_commercial_kind"/>
      </xpath>
    </field>
  </record>

  <record id="project_task_view_form_commercial" model="ir.ui.view">
    <field name="name">project.task.form.commercial.operations</field>
    <field name="model">project.task</field>
    <field name="inherit_id" ref="project.view_task_form2"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='allocated_hours']" position="after">
        <field name="mb_commercial_operation_id" readonly="1" invisible="not mb_commercial_operation_id"/>
        <field name="mb_travel_hours" invisible="not mb_commercial_operation_id"/>
        <field name="mb_on_site_hours" invisible="not mb_commercial_operation_id"/>
      </xpath>
    </field>
  </record>
</odoo>

