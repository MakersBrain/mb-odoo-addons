<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="res_groups_privilege_commercial_operations" model="res.groups.privilege">
    <field name="name">Commercial Operations</field>
    <field name="sequence">28</field>
    <field name="category_id" ref="base.module_category_services_project"/>
  </record>

  <record id="group_commercial_operations_user" model="res.groups">
    <field name="name">User</field>
    <field name="sequence">10</field>
    <field name="privilege_id" ref="res_groups_privilege_commercial_operations"/>
    <field name="implied_ids" eval="[(4, ref('project.group_project_user'))]"/>
  </record>

  <record id="group_commercial_operations_manager" model="res.groups">
    <field name="name">Manager</field>
    <field name="sequence">20</field>
    <field name="privilege_id" ref="res_groups_privilege_commercial_operations"/>
    <field name="implied_ids" eval="[(4, ref('group_commercial_operations_user')), (4, ref('project.group_project_manager'))]"/>
    <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
  </record>

  <record id="rule_commercial_contract_company" model="ir.rule">
    <field name="name">Commercial contracts by company</field>
    <field name="model_id" ref="model_mb_commercial_contract"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    <field name="groups" eval="[(4, ref('group_commercial_operations_user'))]"/>
  </record>
