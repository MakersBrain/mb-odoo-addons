		<field name="domain_force">[('company_id', 'in', company_ids)]</field>
	</record>
	<record id="rule_urssaf_annual_company" model="ir.rule">
		<field name="name">URSSAF annual evidence: active companies</field>
		<field name="model_id" ref="model_l10n_fr_micro_urssaf_annual"/>
		<field name="domain_force">[('company_id', 'in', company_ids)]</field>
	</record>
</odoo>
