<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="rule_urssaf_declaration_company" model="ir.rule">
		<field name="name">URSSAF declarations: active companies</field>
		<field name="model_id" ref="model_l10n_fr_micro_urssaf_declaration"/>
		<field name="domain_force">[('company_id', 'in', company_ids)]</field>
