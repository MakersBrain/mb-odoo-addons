<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="view_urssaf_setup_wizard_form" model="ir.ui.view">
		<field name="name">l10n.fr.micro.urssaf.setup.wizard.form</field>
		<field name="model">l10n.fr.micro.urssaf.setup.wizard</field>
		<field name="arch" type="xml">
			<form string="Set up URSSAF declarations">
				<group>
					<field name="company_id" groups="base.group_multi_company"/>
					<field name="activity_start_date"/>
					<field name="tracking_start_date"/>
					<field name="periodicity"/>
					<field name="accounting_responsible_id"/>
					<field name="acre_granted"/>
				</group>
				<div class="alert alert-info" role="alert" invisible="not acre_granted">ACRE dates and the payable coefficient are derived from the dated rule for the activity start date.</div>
				<footer>
					<button name="action_apply" type="object" string="Apply configuration" class="btn-primary"/>
					<button string="Cancel" special="cancel" class="btn-secondary"/>
				</footer>
			</form>
		</field>
	</record>
	<record id="action_urssaf_setup_wizard" model="ir.actions.act_window">
		<field name="name">Set up URSSAF declarations</field>
		<field name="res_model">l10n.fr.micro.urssaf.setup.wizard</field>
		<field name="view_mode">form</field>
		<field name="target">new</field>
	</record>
</odoo>
