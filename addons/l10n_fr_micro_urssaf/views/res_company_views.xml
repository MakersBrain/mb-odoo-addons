<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="view_company_form_urssaf" model="ir.ui.view">
		<field name="name">res.company.form.micro.urssaf</field>
		<field name="model">res.company</field>
		<field name="inherit_id" ref="base.view_company_form"/>
		<field name="arch" type="xml">
			<xpath expr="//sheet" position="inside">
				<group string="French micro-enterprise — URSSAF" groups="account.group_account_manager">
					<group>
						<field name="l10n_fr_micro_activity_start_date"/>
						<field name="l10n_fr_micro_urssaf_tracking_start_date"/>
						<field name="l10n_fr_micro_urssaf_periodicity"/>
						<field name="l10n_fr_micro_accounting_responsible_id"/>
					</group>
					<group>
						<field name="l10n_fr_micro_cfp_kind"/>
						<field name="l10n_fr_micro_chamber_kind"/>
						<field name="l10n_fr_micro_chamber_zone" invisible="l10n_fr_micro_chamber_kind != 'cma'"/>
						<field name="l10n_fr_micro_versement_from"/>
						<field name="l10n_fr_micro_versement_to"/>
					</group>
					<group string="ACRE">
						<field name="l10n_fr_micro_acre_granted"/>
						<field name="l10n_fr_micro_acre_from" invisible="not l10n_fr_micro_acre_granted"/>
						<field name="l10n_fr_micro_acre_to" invisible="not l10n_fr_micro_acre_granted"/>
						<field name="l10n_fr_micro_acre_coefficient" invisible="not l10n_fr_micro_acre_granted"/>
						<button name="action_l10n_fr_micro_apply_acre_rule" type="object" string="Derive ACRE dates and coefficient" class="btn-secondary"/>
					</group>
				</group>
			</xpath>
		</field>
	</record>
</odoo>
