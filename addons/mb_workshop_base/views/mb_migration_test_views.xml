<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="mb_migration_test_view_list" model="ir.ui.view">
        <field name="name">mb.migration.test.list</field>
        <field name="model">mb.migration.test</field>
        <field name="arch" type="xml">
            <list decoration-danger="not passed">
                <field name="test_date" />
                <field name="lot_id" />
                <field name="product_id" />
                <field name="migration_limit_class" />
                <field name="lead_result" />
                <field name="cadmium_result" />
                <field name="passed" />
            </list>
        </field>
    </record>

    <record id="mb_migration_test_view_form" model="ir.ui.view">
        <field name="name">mb.migration.test.form</field>
        <field name="model">mb.migration.test</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Sample">
                            <field name="lot_id" />
                            <field name="product_id" readonly="1" />
                            <field name="migration_limit_class" />
                        </group>
                        <group string="Result">
                            <field name="test_date" />
                            <field name="laboratory" />
                            <field name="lead_result" />
                            <field name="cadmium_result" />
                            <field name="passed" />
                        </group>
                    </group>
                    <group string="Report">
                        <field name="report_ids" widget="many2many_binary" nolabel="1" />
                    </group>
                    <field name="note" placeholder="Notes" />
                </sheet>
            </form>
        </field>
    </record>

    <record id="mb_migration_test_action" model="ir.actions.act_window">
        <field name="name">Migration tests</field>
        <field name="res_model">mb.migration.test</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
