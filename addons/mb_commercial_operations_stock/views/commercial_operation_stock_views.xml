<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_commercial_operation_form_stock" model="ir.ui.view">
    <field name="name">mb.commercial.operation.form.stock</field>
    <field name="model">mb.commercial.operation</field>
    <field name="inherit_id" ref="mb_commercial_operations.view_commercial_operation_form_planning_report"/>
    <field name="arch" type="xml">
      <xpath expr="//header/field[@name='state']" position="before">
        <button name="action_check_stock_availability" type="object" string="Check Availability"
                invisible="operation_type != 'market' or state not in ('draft', 'quoted', 'approved', 'scheduled')"/>
        <button name="action_prepare_supply" type="object" string="Prepare Supply"
                invisible="not has_supply_plan or state not in ('approved', 'scheduled')"/>
        <button name="action_refresh_supply_status" type="object" string="Refresh Supply Status"
                invisible="not has_supply_plan"/>
        <button name="action_prepare_market_stock" type="object" string="Prepare Market Stock" class="btn-primary"
                invisible="operation_type != 'market' or state not in ('approved', 'scheduled') or preparation_picking_id"/>
        <button name="action_prepare_market_return" type="object" string="Prepare Return"
                invisible="not preparation_picking_id or state not in ('in_progress', 'done')"/>
        <button name="action_stock_close" type="object" string="Close Stock" class="btn-primary"
                invisible="state not in ('done', 'financially_closed') or stock_closed"/>
        <button name="action_reopen_stock" type="object" string="Reopen Stock"
                groups="mb_commercial_operations.group_commercial_operations_manager"
                invisible="not stock_closed"/>
      </xpath>
      <xpath expr="//div[@name='button_box']" position="inside">
        <button class="oe_stat_button" type="object" name="action_view_stock_pickings" icon="fa-exchange"
                invisible="not preparation_picking_id">
          <field name="stock_discrepancy_count" widget="statinfo" string="Stock Differences"/>
        </button>
      </xpath>
      <xpath expr="//field[@name='stock_preparation_deadline']" position="after">
        <field name="has_supply_plan" invisible="1"/>
        <field name="source_warehouse_id" readonly="state not in ('draft', 'quoted')"/>
        <field name="source_location_id" readonly="state not in ('draft', 'quoted')"/>
        <field name="market_location_id" readonly="1"/>
      </xpath>
      <xpath expr="//field[@name='stock_plan_line_ids']/list/field[@name='supply_method']" position="after">
        <field name="on_hand_now" readonly="1" optional="show"/>
        <field name="reserved_now" readonly="1" optional="show"/>
        <field name="incoming_before_cutoff" readonly="1" optional="show"/>
        <field name="outgoing_before_cutoff" readonly="1" optional="show"/>
        <field name="forecast_available" readonly="1" optional="show"/>
        <field name="shortage_qty" readonly="1" optional="show"/>
        <field name="availability_calculated_at" readonly="1" optional="hide"/>
      </xpath>
      <xpath expr="//field[@name='account_move_ids']" position="after">
        <group string="Stock Reconciliation">
          <group>
            <field name="preparation_picking_id" readonly="1"/>
            <field name="return_picking_ids" readonly="1"/>
          </group>
          <group>
            <field name="stock_reconciled" readonly="1"/>
            <field name="stock_closed" readonly="1"/>
            <field name="stock_close_date" readonly="1"/>
            <field name="stock_close_user_id" readonly="1"/>
          </group>
          <field name="stock_reconciliation_note" readonly="1" colspan="2"/>
        </group>
      </xpath>
      <xpath expr="//group[@name='commercial_operation_readiness']" position="before">
        <group string="Stock Readiness">
          <field name="stock_required_qty"/>
          <field name="stock_forecast_qty"/>
          <field name="stock_shortage_qty"/>
          <field name="stock_readiness" widget="badge"/>
          <field name="has_supply_plan"/>
          <field name="stock_reconciled"/>
        </group>
      </xpath>
    </field>
  </record>

  <record id="view_market_stock_plan_line_form_stock" model="ir.ui.view">
    <field name="name">mb.market.stock.plan.line.form.stock</field>
    <field name="model">mb.market.stock.plan.line</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <group>
              <field name="operation_id" readonly="1"/>
              <field name="target_type"/>
              <field name="product_id" invisible="target_type != 'product'"/>
              <field name="category_id" invisible="target_type != 'bucket'"/>
              <field name="desired_opening_qty"/>
              <field name="safety_qty"/>
              <field name="required_qty" readonly="1"/>
              <field name="supply_method"/>
            </group>
            <group>
              <field name="source_warehouse_id" readonly="1"/>
              <field name="on_hand_now" readonly="1"/>
              <field name="reserved_now" readonly="1"/>
              <field name="incoming_before_cutoff" readonly="1"/>
              <field name="outgoing_before_cutoff" readonly="1"/>
              <field name="forecast_available" readonly="1"/>
              <field name="shortage_qty" readonly="1"/>
              <field name="availability_calculated_at" readonly="1"/>
            </group>
          </group>
          <group string="Concrete Stock Selection">
            <field name="stock_closed" invisible="1"/>
            <field name="allocation_ids" readonly="stock_closed">
              <list editable="bottom">
                <field name="product_id"/>
                <field name="lot_id"/>
                <field name="quantity"/>
                <field name="company_id" column_invisible="True"/>
              </list>
            </field>
          </group>
          <field name="blocking_note"/>
        </sheet>
      </form>
    </field>
  </record>
  <record id="view_commercial_operation_plan_wizard_stock" model="ir.ui.view">
    <field name="name">mb.commercial.operation.plan.wizard.stock</field>
    <field name="model">mb.commercial.operation.plan.wizard</field>
    <field name="inherit_id" ref="mb_commercial_operations.view_commercial_planning_wizard_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='contract_id']" position="after">
        <field name="source_warehouse_id"/>
        <field name="source_location_id" domain="[('id', 'child_of', source_warehouse_id.view_location_id)]"/>
        <field name="stock_preparation_deadline"/>
      </xpath>
      <xpath expr="//field[@name='line_ids']" position="before">
        <button name="action_refresh_stock" type="object" string="Refresh Stock Availability" class="btn-secondary" invisible="calculation_mode != 'product_mix'"/>
      </xpath>
      <xpath expr="//field[@name='line_ids']/list/field[@name='expected_sold_qty']" position="after">
        <field name="on_hand_now" optional="show"/>
        <field name="reserved_now" optional="hide"/>
        <field name="forecast_available" optional="show"/>
        <field name="shortage_qty" optional="show"/>
        <field name="readiness" widget="badge" optional="show"/>
      </xpath>
    </field>
  </record>

  <template id="report_commercial_operation_stock" inherit_id="mb_commercial_operations.report_commercial_operation">
    <xpath expr="//div[@name='commercial_bridge_report_sections']" position="inside">
      <h3>Stock execution and reconciliation</h3>
      <p><strong>Source warehouse:</strong> <span t-field="operation.source_warehouse_id"/> · <strong>Preparation deadline:</strong> <span t-field="operation.stock_preparation_deadline"/> · <strong>Preparation transfer:</strong> <span t-field="operation.preparation_picking_id"/></p>
      <table class="table table-sm table-bordered"><thead><tr><th>Product</th><th>On hand</th><th>Reserved</th><th>Forecast</th><th>Shortage</th><th>Supply</th></tr></thead><tbody><tr t-foreach="operation.stock_plan_line_ids" t-as="target"><td><span t-field="target.product_id"/></td><td><span t-field="target.on_hand_now"/></td><td><span t-field="target.reserved_now"/></td><td><span t-field="target.forecast_available"/></td><td><span t-field="target.shortage_qty"/></td><td><span t-field="target.supply_method"/> / <span t-field="target.readiness"/></td></tr></tbody></table>
      <p><strong>Stock reconciliation:</strong> <span t-field="operation.stock_reconciliation_note"/></p>
    </xpath>
  </template>
</odoo>
