<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_shop_import" model="ir.module.category">
        <field name="name">Shop Catalogue Import</field>
        <field name="sequence">46</field>
    </record>
    <record id="privilege_shop_import" model="res.groups.privilege">
        <field name="name">Shop Catalogue Import</field>
        <field name="category_id" ref="module_category_shop_import"/>
        <field name="sequence">46</field>
    </record>
    <record id="group_shop_import_reviewer" model="res.groups">
        <field name="name">Reviewer</field>
        <field name="privilege_id" ref="privilege_shop_import"/>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>
    <record id="group_shop_import_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_shop_import"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[(4, ref('group_shop_import_reviewer'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_shop_source_company" model="ir.rule">
        <field name="name">Shop sources stay in active companies</field>
        <field name="model_id" ref="model_mb_shop_source"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_shop_binding_company" model="ir.rule">
        <field name="name">Shop product bindings stay in active companies</field>
        <field name="model_id" ref="model_mb_shop_product_binding"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_shop_import_batch_company" model="ir.rule">
        <field name="name">Shop import batches stay in active companies</field>
        <field name="model_id" ref="model_mb_shop_import_batch"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_shop_import_line_company" model="ir.rule">
        <field name="name">Shop import lines stay in active companies</field>
        <field name="model_id" ref="model_mb_shop_import_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
