<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shop_import_batch_kanban" model="ir.ui.view">
        <field name="name">mb.shop.import.batch.kanban</field>
        <field name="model">mb.shop.import.batch</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="source_id"/>
                <field name="state"/>
                <field name="total_count"/>
                <field name="warning_count"/>
                <field name="error_count"/>
                <templates>
                    <t t-name="card">
                        <main>
                            <field name="name" class="fw-bold fs-5"/>
                            <div><field name="source_id"/></div>
                            <div class="text-muted">
                                <field name="total_count"/> lines ·
                                <field name="warning_count"/> warnings ·
                                <field name="error_count"/> errors
                            </div>
                            <footer><field name="state" widget="label_selection"/></footer>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_shop_import_batch_list" model="ir.ui.view">
        <field name="name">mb.shop.import.batch.list</field>
        <field name="model">mb.shop.import.batch</field>
        <field name="arch" type="xml">
            <list delete="0" decoration-danger="state == 'failed'" decoration-success="state == 'done'">
                <field name="name"/>
                <field name="source_id"/>
                <field name="file_name"/>
                <field name="parsed_adapter_key" optional="show"/>
                <field name="total_count"/>
                <field name="selected_count"/>
                <field name="warning_count"/>
                <field name="error_count"/>
                <field name="state"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="create_date" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_shop_import_batch_search" model="ir.ui.view">
        <field name="name">mb.shop.import.batch.search</field>
        <field name="model">mb.shop.import.batch</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="source_id"/>
                <field name="file_name"/>
                <filter name="needs_review" string="Needs review" domain="[('state', 'in', ('review', 'ready', 'failed'))]"/>
                <filter name="completed" string="Completed" domain="[('state', '=', 'done')]"/>
                <group>
                    <filter name="group_source" string="Source" context="{'group_by': 'source_id'}"/>
                    <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_shop_import_batch_form" model="ir.ui.view">
        <field name="name">mb.shop.import.batch.form</field>
        <field name="model">mb.shop.import.batch</field>
        <field name="arch" type="xml">
            <form delete="0">
                <header>
                    <button name="action_parse" type="object" string="Parse file"
                            class="btn-primary" invisible="state not in ('uploaded', 'review', 'failed')"/>
                    <button name="action_validate" type="object" string="Validate"
                            class="btn-primary" invisible="state not in ('review', 'ready', 'failed') or total_count == 0"/>
                    <button name="action_select_valid" type="object" string="Select valid"
                            invisible="state not in ('review', 'ready') or total_count == 0"/>
                    <button name="action_open_lines" type="object" string="Filter review lines"
                            invisible="total_count == 0"/>
                    <button name="action_acknowledge_warnings" type="object" string="Acknowledge warnings"
                            invisible="state != 'ready' or warning_count == 0 or warnings_acknowledged_at"/>
                    <button name="action_import_selected" type="object" string="Import selected"
                            class="btn-primary" groups="mb_shop_import.group_shop_import_manager"
                            invisible="state != 'ready' or selected_count == 0"/>
                    <button name="action_open_products" type="object" string="Open products"
                            invisible="state != 'done'"/>
                    <button name="action_import_images" type="object" string="Import/retry images"
                            groups="mb_shop_import.group_shop_import_manager"
                            invisible="state != 'done' or not import_images"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('done', 'cancelled', 'importing')"/>
                    <field name="state" widget="statusbar" statusbar_visible="uploaded,review,ready,done"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Failed" bg_color="text-bg-danger"
                            invisible="state != 'failed'"/>
                    <group>
                        <group string="Source artifact">
                            <field name="name" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'uploaded'"/>
                            <field name="source_id" readonly="state not in ('uploaded', 'review', 'failed')"/>
                            <field name="adapter_key" readonly="state not in ('uploaded', 'review', 'failed')"/>
                            <field name="source_file" filename="file_name"
                                   required="state == 'uploaded'"
                                   readonly="state not in ('uploaded', 'review', 'failed')"/>
                            <field name="file_name" invisible="1"/>
                            <field name="file_sha256" readonly="1" invisible="not file_sha256"/>
                            <field name="parsed_adapter_key" readonly="1" invisible="not parsed_adapter_key"/>
                            <field name="source_snapshot_from" readonly="1" invisible="not source_snapshot_from"/>
                            <field name="source_snapshot_at" readonly="1" invisible="not source_snapshot_at"/>
                        </group>
                        <group string="Import policy">
                            <field name="target_location_id" readonly="state in ('importing', 'done', 'cancelled')"/>
                            <field name="product_category_id" readonly="state in ('importing', 'done', 'cancelled')"/>
                            <field name="currency_id" readonly="1"/>
                            <field name="price_tax_basis" readonly="state in ('importing', 'done', 'cancelled')"/>
                            <field name="sales_tax_ids" widget="many2many_tags"
                                   invisible="price_tax_basis == 'no_sales_tax'"
                                   readonly="state in ('importing', 'done', 'cancelled')"/>
                            <field name="snapshot_max_age_hours" readonly="state in ('importing', 'done', 'cancelled')"/>
                            <field name="snapshot_stale_policy" readonly="state in ('importing', 'done', 'cancelled')"/>
                            <field name="update_existing_prices" readonly="state in ('importing', 'done', 'cancelled')"/>
                            <field name="import_images" readonly="state in ('importing', 'done', 'cancelled')"/>
                            <field name="overwrite_images" invisible="not import_images"
                                   readonly="state in ('importing', 'done', 'cancelled')"/>
                        </group>
                    </group>
                    <group string="Review summary" invisible="total_count == 0">
                        <field name="total_count"/>
                        <field name="selected_count"/>
                        <field name="create_count"/>
                        <field name="update_count"/>
                        <field name="warning_count"/>
                        <field name="error_count"/>
                        <field name="validated_at"/>
                        <field name="warnings_acknowledged_at"/>
                        <field name="warnings_acknowledged_by_id"/>
                    </group>
                    <group string="Failure" invisible="not failure_detail">
                        <field name="failure_detail" readonly="1" nolabel="1"/>
                    </group>
                    <notebook invisible="total_count == 0">
                        <page string="Review lines">
                            <field name="line_ids" nolabel="1">
                                <list create="0" delete="0" editable="bottom"
                                      decoration-danger="validation_status == 'error'"
                                      decoration-warning="validation_status == 'warning'"
                                      decoration-success="validation_status == 'ingested'">
                                    <field name="selected"/>
                                    <field name="validation_status"/>
                                    <field name="proposed_action" readonly="1"/>
                                    <field name="name"/>
                                    <field name="variant_title" optional="hide"/>
                                    <field name="default_code"/>
                                    <field name="source_category" readonly="1"/>
                                    <field name="is_service"/>
                                    <field name="source_price"/>
                                    <field name="current_list_price" readonly="1" optional="show"/>
                                    <field name="proposed_list_price" readonly="1"/>
                                    <field name="proposed_customer_price" readonly="1" optional="show"/>
                                    <field name="stock_is_tracked" readonly="1"/>
                                    <field name="stock_quantity"/>
                                    <field name="reviewed_quantity" readonly="1" optional="show"/>
                                    <field name="reviewed_reserved_quantity" readonly="1" optional="hide"/>
                                    <field name="matched_product_id" readonly="1"/>
                                    <field name="manual_product_id" optional="hide"/>
                                    <field name="current_name" readonly="1" optional="hide"/>
                                    <field name="match_method" readonly="1" optional="show"/>
                                    <field name="identity_is_fallback" readonly="1" optional="hide"/>
                                    <field name="validation_messages" readonly="1" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="Result" invisible="state != 'done'">
                            <field name="result_summary" widget="json" readonly="1"/>
                            <field name="affected_product_tmpl_ids" widget="many2many_tags" readonly="1"/>
                            <field name="imported_at" readonly="1"/>
                            <field name="imported_by_id" readonly="1"/>
                            <button name="action_purge_source_evidence" type="object"
                                    string="Purge retained source file and raw records"
                                    groups="mb_shop_import.group_shop_import_manager"
                                    confirm="The normalized audit summary remains, but the original file and raw records will be removed."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_shop_import_line_list" model="ir.ui.view">
        <field name="name">mb.shop.import.line.list</field>
        <field name="model">mb.shop.import.line</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" editable="bottom"
                  decoration-danger="validation_status == 'error'"
                  decoration-warning="validation_status == 'warning'">
                <field name="selected"/>
                <field name="validation_status"/>
                <field name="proposed_action" readonly="1"/>
                <field name="name"/>
                <field name="default_code"/>
                <field name="source_category" readonly="1"/>
                <field name="is_service"/>
                <field name="source_price"/>
                <field name="current_list_price" readonly="1"/>
                <field name="proposed_list_price" readonly="1"/>
                <field name="stock_is_tracked" readonly="1"/>
                <field name="stock_quantity"/>
                <field name="reviewed_quantity" readonly="1"/>
                <field name="matched_product_id" readonly="1"/>
                <field name="manual_product_id"/>
                <field name="validation_messages" readonly="1" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_shop_import_line_search" model="ir.ui.view">
        <field name="name">mb.shop.import.line.search</field>
        <field name="model">mb.shop.import.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="default_code"/>
                <field name="batch_id"/>
                <filter name="errors" string="Errors" domain="[('validation_status', '=', 'error')]"/>
                <filter name="warnings" string="Warnings" domain="[('validation_status', '=', 'warning')]"/>
                <filter name="new" string="New" domain="[('proposed_action', '=', 'create')]"/>
                <filter name="matched" string="Matched" domain="[('matched_product_id', '!=', False)]"/>
                <filter name="price_changes" string="Price changes" domain="[('price_changed', '=', True)]"/>
                <filter name="stock_changes" string="Stock changes" domain="[('stock_changed', '=', True)]"/>
                <filter name="untracked" string="Untracked stock" domain="[('stock_is_tracked', '=', False), ('is_service', '=', False)]"/>
                <filter name="services" string="Services" domain="[('is_service', '=', True)]"/>
                <filter name="duplicates" string="Duplicates" domain="[('duplicate_code', '=', True)]"/>
                <filter name="missing_images" string="Missing images" domain="[('image_url', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_shop_import_lines" model="ir.actions.act_window">
        <field name="name">Shop import review lines</field>
        <field name="res_model">mb.shop.import.line</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_shop_import_line_search"/>
    </record>

    <record id="view_shop_source_list" model="ir.ui.view">
        <field name="name">mb.shop.source.list</field>
        <field name="model">mb.shop.source</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="provider_key"/>
                <field name="source_key"/>
                <field name="sku_prefix"/>
                <field name="last_seen_at"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_shop_source_form" model="ir.ui.view">
        <field name="name">mb.shop.source.form</field>
        <field name="model">mb.shop.source</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="provider_key"/>
                            <field name="source_key"/>
                            <field name="sku_prefix"/>
                            <field name="homepage_url" widget="url"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="service_category_names" placeholder="One source category per line"/>
                            <field name="allowed_image_hosts" placeholder="One HTTPS hostname per line"/>
                            <field name="last_seen_at" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_shop_import_batches" model="ir.actions.act_window">
        <field name="name">Shop catalogue imports</field>
        <field name="res_model">mb.shop.import.batch</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_needs_review': 1}</field>
    </record>
    <record id="action_shop_sources" model="ir.actions.act_window">
        <field name="name">Scraped shop sources</field>
        <field name="res_model">mb.shop.source</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_shop_import_batches" name="Shop catalogue imports"
              parent="stock.menu_stock_root" action="action_shop_import_batches"
              sequence="72" groups="mb_shop_import.group_shop_import_reviewer"/>
    <menuitem id="menu_shop_sources" name="Scraped shop sources"
              parent="menu_shop_import_batches" action="action_shop_sources"
              sequence="10" groups="mb_shop_import.group_shop_import_manager"/>
</odoo>
