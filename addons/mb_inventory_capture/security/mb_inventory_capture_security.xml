<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_inventory_capture_company" model="ir.rule">
        <field name="name">Inventory captures stay in active companies</field>
        <field name="model_id" ref="model_mb_inventory_capture"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_inventory_capture_asset_company" model="ir.rule">
        <field name="name">Inventory capture assets stay in active companies</field>
        <field name="model_id" ref="model_mb_inventory_capture_asset"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_inventory_capture_attempt_company" model="ir.rule">
        <field name="name">Inventory capture attempts stay in active companies</field>
        <field name="model_id" ref="model_mb_inventory_capture_attempt"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_inventory_capture_candidate_company" model="ir.rule">
        <field name="name">Inventory capture candidates stay in active companies</field>
        <field name="model_id" ref="model_mb_inventory_capture_candidate"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_product_identifier_company" model="ir.rule">
        <field name="name">Product identifiers use active or global companies</field>
        <field name="model_id" ref="model_mb_product_identifier"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>

