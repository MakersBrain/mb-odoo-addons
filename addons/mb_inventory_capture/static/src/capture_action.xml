<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="mb_inventory_capture.CaptureAction">
        <div class="o_mb_inventory_capture h-100 overflow-auto p-3">
            <div class="mx-auto" style="max-width: 58rem">
                <h2>Identify incoming product</h2>
                <p class="text-muted">
                    Photograph the product/front label, then add a lot-detail image if needed.
                    Nothing changes inventory until the reviewed result is applied.
                </p>
                <div class="alert alert-info" role="status">
                    Uploaded images are sanitized to remove metadata. If you request analysis,
                    the sanitized images leave Odoo temporarily and are processed by your
                    workshop's configured extraction provider.
                </div>
                <div class="d-flex gap-2 flex-wrap mb-3">
                    <button class="btn btn-primary" t-on-click="startCamera"
                            t-att-disabled="state.busy">Use camera</button>
                    <button class="btn btn-secondary" t-on-click="() => fileInput.el.click()"
                            t-att-disabled="state.busy">
                        <t t-if="state.uploadedRoles.includes(state.role)">Retake selected image</t>
                        <t t-else="">Upload image</t>
                    </button>
                    <select class="form-select w-auto" t-model="state.role">
                        <option value="front">Product/front</option>
                        <option value="lot_detail">Lot detail</option>
                    </select>
                    <input t-ref="fileInput" type="file" class="d-none"
                           accept="image/jpeg,image/png" capture="environment"
                           t-on-change="onFileChange"/>
                </div>
                <div class="ratio ratio-4x3 bg-dark mb-3" t-att-class="{'d-none': !state.cameraActive}">
                    <video t-ref="video" autoplay="autoplay" playsinline="playsinline" muted="muted"/>
                    <div class="o_mb_scan_guide" aria-hidden="true"/>
                </div>
                <div t-if="state.cameraActive" class="d-flex gap-2 mb-2">
                    <button class="btn btn-primary" t-on-click="takePhoto"
                            t-att-disabled="state.busy">Take photo</button>
                    <button t-if="state.torchAvailable" class="btn btn-outline-light"
                            t-on-click="toggleTorch">
                        <t t-if="state.torchOn">Turn torch off</t><t t-else="">Turn torch on</t>
                    </button>
                </div>
                <div t-if="state.cameraActive" class="alert py-2 mb-3"
                     t-att-class="state.lookupState === 'found' ? 'alert-success' : 'alert-secondary'"
                     role="status" aria-live="polite">
                    <span t-out="state.scanHint"/>
                </div>
                <div t-if="state.previewUrl" class="mb-3">
                    <p class="small text-muted mb-1">Drag over the visible lot/batch text, then rotate if needed.</p>
                    <div class="o_mb_crop_surface rounded"
                         t-on-pointerdown="onCropPointerDown"
                         t-on-pointermove="onCropPointerMove"
                         t-on-pointerup="onCropPointerUp"
                         t-on-pointercancel="onCropPointerUp">
                        <img t-att-src="state.previewUrl" class="img-fluid d-block"
                             draggable="false" alt="Accepted image preview for selecting the lot area"/>
                        <div class="o_mb_crop_selection" t-att-style="cropStyle" aria-hidden="true"/>
                    </div>
                    <div class="d-flex gap-2 flex-wrap mt-2">
                        <button class="btn btn-outline-primary" t-on-click="createLotCrop"
                                t-att-disabled="state.busy || state.cropReady">
                            Use selected area for lot reading
                        </button>
                        <select class="form-select w-auto" t-model="state.cropRotation"
                                aria-label="Rotate lot text before reading">
                            <option value="0">No rotation</option>
                            <option value="90">Rotate 90°</option>
                            <option value="180">Rotate 180°</option>
                            <option value="270">Rotate 270°</option>
                        </select>
                        <label class="form-check align-self-center mb-0">
                            <input type="checkbox" class="form-check-input"
                                   t-model="state.enhanceCrop"/>
                            <span class="form-check-label">Also try black-and-white high contrast for OCR</span>
                        </label>
                    </div>
                </div>
                <div class="input-group mb-3">
                    <input class="form-control" t-model="state.manualCode"
                           placeholder="Enter an unreadable barcode or GS1 value"/>
                    <button class="btn btn-outline-secondary" t-on-click="submitManualCode">
                        Add code
                    </button>
                </div>
                <ul t-if="state.decoded.length" class="list-group mb-3">
                    <li t-foreach="state.decoded" t-as="code" t-key="code_index"
                        class="list-group-item d-flex justify-content-between">
                        <code t-out="code.rawValue"/><span t-out="code.format"/>
                    </li>
                </ul>
                <button t-if="state.cameraActive &amp;&amp; state.decoded.length"
                        class="btn btn-outline-secondary mb-3" t-on-click="scanAgain">
                    Reject this read and scan again
                </button>
                <div class="d-flex gap-2">
                    <button class="btn btn-primary" t-on-click="analyzeImages"
                            t-att-disabled="state.busy || !state.uploaded">
                        Analyze images (OCR / enabled AI fallback)
                    </button>
                    <button class="btn btn-secondary" t-on-click="openReview"
                            t-att-disabled="state.busy">Review manually</button>
                </div>
            </div>
        </div>
    </t>
</templates>
