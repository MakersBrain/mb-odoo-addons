<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mb_inventory_capture_list" model="ir.ui.view">
        <field name="name">mb.inventory.capture.list</field>
        <field name="model">mb.inventory.capture</field>
        <field name="arch" type="xml">
            <list create="1" delete="0">
                <field name="name"/>
                <field name="create_date"/>
                <field name="picking_id"/>
                <field name="product_id"/>
                <field name="lot_id"/>
                <field name="state"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_mb_inventory_capture_search" model="ir.ui.view">
        <field name="name">mb.inventory.capture.search</field>
        <field name="model">mb.inventory.capture</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="picking_id"/>
                <field name="product_id"/>
                <field name="lot_id"/>
                <filter name="needs_review" string="Needs review"
                        domain="[('state', '=', 'review')]"/>
                <filter name="processing" string="Processing"
                        domain="[('state', '=', 'processing')]"/>
                <group>
                    <filter name="state" string="State" context="{'group_by': 'state'}"/>
                    <filter name="product" string="Product" context="{'group_by': 'product_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_mb_inventory_capture_form" model="ir.ui.view">
        <field name="name">mb.inventory.capture.form</field>
        <field name="model">mb.inventory.capture</field>
        <field name="arch" type="xml">
            <form delete="0">
                <header>
                    <button name="action_apply" type="object" string="Apply to receipt"
                            class="btn-primary" invisible="state != 'review'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('applied', 'cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,processing,review,applied"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Failed" bg_color="text-bg-danger"
                            invisible="state != 'failed'"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="capture_uuid"/>
                            <field name="picking_id"/>
                            <field name="move_id" domain="[('picking_id', '=', picking_id)]"/>
                            <field name="move_line_id" domain="[('move_id', '=', move_id)]"/>
                        </group>
                        <group>
                            <field name="product_id" readonly="state in ('applied', 'cancelled')"/>
                            <field name="proposed_lot" readonly="state in ('applied', 'cancelled')"/>
                            <field name="lot_id" readonly="1"/>
                            <field name="proposed_quantity" readonly="state in ('applied', 'cancelled')"/>
                            <field name="proposed_expiry" readonly="state in ('applied', 'cancelled')"/>
                            <field name="apply_expiry" invisible="not proposed_expiry"
                                   readonly="state in ('applied', 'cancelled')"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Failure" invisible="not failure_code">
                        <field name="failure_code"/>
                        <field name="failure_detail"/>
                    </group>
                    <notebook>
                        <page string="Evidence images">
                            <field name="asset_ids" nolabel="1" readonly="1">
                                <list create="0" delete="0">
                                    <field name="role"/>
                                    <field name="attachment_id"/>
                                    <field name="mimetype"/>
                                    <field name="pixel_width"/>
                                    <field name="pixel_height"/>
                                    <field name="sanitized_sha256" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Candidates">
                            <field name="candidate_ids" nolabel="1">
                                <list create="0" delete="0" editable="bottom">
                                    <field name="kind" readonly="1"/>
                                    <field name="raw_value" readonly="1"/>
                                    <field name="normalized_value" readonly="1" optional="hide"/>
                                    <field name="product_id" readonly="1"/>
                                    <field name="source" readonly="1"/>
                                    <field name="confidence" readonly="1" widget="percentage"/>
                                    <field name="grounding_state" readonly="1"/>
                                    <field name="decision"/>
                                    <field name="reviewed_value"/>
                                </list>
                            </field>
                        </page>
                        <page string="Extraction attempts">
                            <field name="attempt_ids" nolabel="1" readonly="1">
                                <list create="0" delete="0">
                                    <field name="kind"/>
                                    <field name="provider"/>
                                    <field name="model"/>
                                    <field name="state"/>
                                    <field name="started_at"/>
                                    <field name="ended_at"/>
                                    <field name="failure_code"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <group string="Applied decision" invisible="state != 'applied'">
                        <field name="applied_by"/>
                        <field name="applied_at"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_mb_inventory_capture" model="ir.actions.act_window">
        <field name="name">Product photo captures</field>
        <field name="res_model">mb.inventory.capture</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_needs_review': 1}</field>
    </record>

    <menuitem id="menu_mb_inventory_capture" name="Product photo captures"
              parent="mb_workshop_base.menu_mb_ceramics_stock_quality"
              action="action_mb_inventory_capture" sequence="30"
              groups="stock.group_stock_user"/>
</odoo>
