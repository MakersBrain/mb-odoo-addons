<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inventory_capture" model="ir.ui.view">
        <field name="name">stock.picking.form.inventory.capture</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_mb_identify_from_photo" type="object"
                        string="Identify from photo" class="btn-secondary"
                        groups="stock.group_stock_user"
                        invisible="picking_type_code != 'incoming' or state in ('done', 'cancel')"/>
            </xpath>
        </field>
    </record>
</odoo>

