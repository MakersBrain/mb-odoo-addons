<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mb_supplier_lot_migration_form" model="ir.ui.view">
        <field name="name">mb.supplier.lot.migration.form</field>
        <field name="model">mb.supplier.lot.migration</field>
        <field name="arch" type="xml">
            <form string="Supplier lot tracking cutover">
                <group>
                    <field name="product_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    <field name="eligible_product_ids" widget="many2many_tags" invisible="not analyzed"/>
                    <field name="analyzed" invisible="1"/>
                    <field name="report" nolabel="1" invisible="not analyzed"/>
                </group>
                <footer>
                    <button name="action_analyze" type="object" string="Analyze"
                            class="btn-primary"/>
                    <button name="action_apply_safe" type="object" string="Apply safe changes"
                            class="btn-primary" invisible="not analyzed or not eligible_product_ids"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_mb_supplier_lot_migration" model="ir.actions.act_window">
        <field name="name">Supplier lot tracking cutover</field>
        <field name="res_model">mb.supplier.lot.migration</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <menuitem id="menu_mb_supplier_lot_migration" name="Supplier lot tracking cutover"
              parent="mb_workshop_base.menu_mb_workshop_stock_quality"
              action="action_mb_supplier_lot_migration" sequence="40"
              groups="stock.group_stock_manager"/>
</odoo>
