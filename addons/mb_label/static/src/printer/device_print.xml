<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="mb_label.LabelDevicePrint">
        <div class="o_mb_device_print container py-4">
            <t t-if="state.job">
                <div class="row g-4 justify-content-center">
                    <div class="col-lg-6 text-center">
                        <div class="o_mb_print_preview p-4 rounded border bg-light"><img t-att-src="state.job.png_url" t-att-alt="state.job.name"/></div>
                        <p class="text-muted mt-2"><t t-esc="state.job.width_mm"/> × <t t-esc="state.job.height_mm"/> mm · <t t-esc="state.job.dpi"/> dpi · <t t-esc="state.job.copies"/> copies</p>
                    </div>
                    <div class="col-lg-4">
                        <h2 class="h4">Print label</h2>
                        <p><t t-esc="state.job.name"/></p>
                        <label class="form-label">Destination</label>
                        <select class="form-select" t-on-change="selectAdapter" t-att-value="state.adapter">
                            <t t-foreach="state.adapters" t-as="adapter" t-key="adapter.id">
                                <option t-att-value="adapter.id" t-att-disabled="!adapter.available"><t t-esc="adapter.label"/><t t-if="!adapter.available"> — unavailable</t></option>
                            </t>
                        </select>
                        <t t-if="state.adapter === 'phomemo' || state.adapter === 'niimbot'">
                            <label class="form-label mt-3">Density: <t t-esc="state.density"/></label>
                            <input class="form-range" type="range" min="1" t-att-max="state.adapter === 'niimbot' ? 5 : 15" t-model="state.density"/>
                        </t>
                        <t t-if="state.adapter === 'phomemo'">
                            <label class="form-label mt-3">Speed: <t t-esc="state.speed"/></label>
                            <input class="form-range" type="range" min="1" max="15" t-model="state.speed"/>
                        </t>
                        <div class="alert alert-warning mt-3" t-if="(state.adapter === 'phomemo' || state.adapter === 'niimbot') &amp;&amp; !state.bleAvailable">
                            Web Bluetooth requires Chrome or Edge on desktop/Android. Use system print on iPhone/iPad.
                        </div>
                        <div class="d-grid gap-2 mt-4">
                            <button class="btn btn-primary btn-lg" t-on-click="print" t-att-disabled="state.busy"><t t-if="state.busy">Printing…</t><t t-elif="state.printedCount">Print another</t><t t-else="">Print</t></button>
                            <button t-if="state.adapter === 'phomemo' || state.adapter === 'niimbot'" class="btn btn-outline-primary" t-on-click="chooseAnother" t-att-disabled="state.busy">Choose another printer and print</button>
                            <p t-if="state.printedCount" class="small text-success text-center mb-0"><t t-esc="state.printedCount"/> successful send<t t-if="state.printedCount !== 1">s</t> in this window</p>
                            <button class="btn btn-outline-secondary" t-on-click="downloadPdf">Download exact-size PDF</button>
                            <button class="btn btn-link" t-on-click="close">Close</button>
                        </div>
                    </div>
                </div>
            </t>
            <t t-else=""><div class="text-center p-5">Preparing label…</div></t>
        </div>
    </t>
</templates>
