<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_mb_label" model="ir.ui.view">
        <field name="name">product.template.form.mb.label</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_mb_create_label" type="object" class="oe_stat_button" icon="fa-pencil-square-o" groups="mb_label.group_mb_label_manager">
                    <div class="o_field_widget o_stat_info"><span class="o_stat_text">Create Label</span></div>
                </button>
                <button name="action_mb_print_label" type="object" class="oe_stat_button" icon="fa-print" groups="mb_label.group_mb_label_user">
                    <div class="o_field_widget o_stat_info"><span class="o_stat_text">Print Label</span></div>
                </button>
            </xpath>
        </field>
    </record>
    <record id="product_product_form_mb_label" model="ir.ui.view">
        <field name="name">product.product.form.mb.label</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_mb_create_label" type="object" class="oe_stat_button" icon="fa-pencil-square-o" groups="mb_label.group_mb_label_manager">
                    <div class="o_field_widget o_stat_info"><span class="o_stat_text">Create Label</span></div>
                </button>
                <button name="action_mb_print_label" type="object" class="oe_stat_button" icon="fa-print" groups="mb_label.group_mb_label_user">
                    <div class="o_field_widget o_stat_info"><span class="o_stat_text">Print Label</span></div>
                </button>
            </xpath>
        </field>
    </record>
    <record id="server_action_mb_product_print_label" model="ir.actions.server">
        <field name="name">Print Makersbrain Label</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = records[:1].action_mb_print_label()</field>
    </record>
</odoo>
