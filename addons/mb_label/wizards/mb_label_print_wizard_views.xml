<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mb_label_print_wizard_form" model="ir.ui.view">
        <field name="name">mb.label.print.wizard.form</field>
        <field name="model">mb.label.print.wizard</field>
        <field name="arch" type="xml">
            <form string="Print Label">
                <group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="product_tmpl_id"/>
                        <field name="product_id" options="{'no_create': True}"/>
                        <field name="lot_id" options="{'no_create': True}"/>
                    </group>
                    <group>
                        <field name="template_id" options="{'no_create': True}"/>
                        <field name="copies"/>
                        <field name="manual_values_json" widget="json"/>
                    </group>
                </group>
                <field name="preview_html" nolabel="1" readonly="1"/>
                <field name="preview_error" nolabel="1" readonly="1" class="text-danger" invisible="not preview_error"/>
                <field name="preview_png" widget="image" nolabel="1" readonly="1" class="oe_avatar" invisible="not preview_png"/>
                <footer>
                    <button name="action_device_print" type="object" string="Print to Device" class="btn-primary"/>
                    <button name="action_browser_print" type="object" string="Browser Print" class="btn-secondary"/>
                    <button name="action_download_pdf" type="object" string="Download PDF" class="btn-secondary"/>
                    <button string="Cancel" special="cancel" class="btn-link"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_mb_label_print_wizard" model="ir.actions.act_window">
        <field name="name">Print Label</field>
        <field name="res_model">mb.label.print.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
