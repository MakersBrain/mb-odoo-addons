<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_mb_labels" model="ir.module.category">
        <field name="name">Label Studio</field>
        <field name="sequence">45</field>
    </record>
    <record id="privilege_mb_labels" model="res.groups.privilege">
        <field name="name">Label Studio</field>
        <field name="category_id" ref="module_category_mb_labels"/>
        <field name="sequence">45</field>
    </record>
    <record id="group_mb_label_user" model="res.groups">
        <field name="name">Printer</field>
        <field name="privilege_id" ref="privilege_mb_labels"/>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_mb_label_manager" model="res.groups">
        <field name="name">Designer</field>
        <field name="privilege_id" ref="privilege_mb_labels"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[(4, ref('group_mb_label_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
    <record id="stock.group_stock_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_mb_label_user'))]"/>
    </record>
    <record id="stock.group_stock_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_mb_label_manager'))]"/>
    </record>

    <record id="rule_mb_label_template_company" model="ir.rule">
        <field name="name">Label templates: company</field>
        <field name="model_id" ref="model_mb_label_template"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_mb_label_version_company" model="ir.rule">
        <field name="name">Label versions: company</field>
        <field name="model_id" ref="model_mb_label_template_version"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_mb_label_alias_company" model="ir.rule">
        <field name="name">Label aliases: company</field>
        <field name="model_id" ref="model_mb_label_qr_alias"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_mb_label_job_company" model="ir.rule">
        <field name="name">Label jobs: company</field>
        <field name="model_id" ref="model_mb_label_print_job"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
