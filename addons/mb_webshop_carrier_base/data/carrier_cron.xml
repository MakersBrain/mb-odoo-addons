<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_carrier_shipments" model="ir.cron">
        <field name="name">MakersBrain: process carrier shipments</field>
        <field name="model_id" ref="model_mb_carrier_shipment"/>
        <field name="state">code</field>
        <field name="code">model._cron_process()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>
    <record id="ir_cron_carrier_webhooks" model="ir.cron">
        <field name="name">MakersBrain: process carrier webhook inbox</field>
        <field name="model_id" ref="model_mb_carrier_webhook_event"/>
        <field name="state">code</field>
        <field name="code">model._cron_process()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>
    <record id="ir_cron_carrier_provider_state" model="ir.cron">
        <field name="name">MakersBrain: reconcile carrier tracking and cancellations</field>
        <field name="model_id" ref="model_mb_carrier_shipment"/>
        <field name="state">code</field>
        <field name="code">model._cron_reconcile_provider_state()</field>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>
    <record id="ir_cron_carrier_retention" model="ir.cron">
        <field name="name">MakersBrain: purge transient carrier data</field>
        <field name="model_id" ref="model_mb_carrier_pickup_point"/>
        <field name="state">code</field>
        <field name="code">model._cron_purge(); env['mb.carrier.public.rate']._cron_purge(); env['mb.carrier.request.log']._cron_purge(); env['mb.carrier.webhook.event']._cron_purge()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
    <record id="ir_cron_carrier_webhook_health" model="ir.cron">
        <field name="name">MakersBrain: check carrier webhook health</field>
        <field name="model_id" ref="delivery.model_delivery_carrier"/>
        <field name="state">code</field>
        <field name="code">model._mb_cron_check_webhooks()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
</odoo>
