<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mb_carrier_shipment_list" model="ir.ui.view">
        <field name="name">mb.carrier.shipment.list</field>
        <field name="model">mb.carrier.shipment</field>
        <field name="arch" type="xml">
            <list decoration-danger="state in ('failed', 'unknown')"
                  decoration-warning="state in ('draft', 'submitting', 'awaiting_document', 'cancel_pending')"
                  decoration-success="state == 'label_ready'">
                <field name="name"/>
                <field name="carrier_id"/>
                <field name="direction"/>
                <field name="state"/>
                <field name="provider_ref"/>
                <field name="tracking_number"/>
                <field name="last_error"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>
    <record id="view_mb_carrier_shipment_form" model="ir.ui.view">
        <field name="name">mb.carrier.shipment.form</field>
        <field name="model">mb.carrier.shipment</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <header>
                    <button name="action_retry" type="object" string="Retry"
                            invisible="state != 'failed'" class="btn-primary"/>
                    <button name="action_reconcile" type="object" string="Reconcile"
                            invisible="state != 'unknown' or operation != 'create'"
                            class="btn-secondary"/>
                    <button name="action_confirm_absent" type="object" string="Confirm absent"
                            invisible="state != 'unknown' or operation != 'create'"
                            confirm="Verify in the provider portal first. Confirm only when no shipment or charge exists; this enables a new purchase."
                            class="btn-secondary"/>
                    <button name="action_confirm_cancelled" type="object" string="Confirm cancelled"
                            invisible="state != 'unknown' or operation != 'cancel'"
                            confirm="Verify in the provider portal first. Confirm that this shipment is cancelled."
                            class="btn-secondary"/>
                    <button name="action_confirm_not_cancelled" type="object" string="Confirm still active"
                            invisible="state != 'unknown' or operation != 'cancel'"
                            confirm="Verify in the provider portal first. This enables a cancellation retry."
                            class="btn-secondary"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <h1><field name="name"/></h1>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="carrier_id"/>
                            <field name="picking_id"/>
                            <field name="direction"/>
                            <field name="parcel_index"/>
                        </group>
                        <group>
                            <field name="operation"/>
                            <field name="provider_ref"/>
                            <field name="tracking_number"/>
                            <field name="tracking_url" widget="url"/>
                            <field name="last_error"/>
                        </group>
                    </group>
                    <field name="document_ids" widget="many2many_binary" readonly="1"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_mb_carrier_shipments" model="ir.actions.act_window">
        <field name="name">Provider Shipments</field>
        <field name="res_model">mb.carrier.shipment</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_mb_carrier_shipments" name="Provider Shipments"
              parent="stock.menu_stock_root" action="action_mb_carrier_shipments"
              groups="stock.group_stock_user" sequence="70"/>
</odoo>
