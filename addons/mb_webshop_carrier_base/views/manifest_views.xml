<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mb_carrier_manifest_list" model="ir.ui.view">
        <field name="name">mb.carrier.manifest.list</field>
        <field name="model">mb.carrier.manifest</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'ready'" decoration-danger="state == 'failed'">
                <field name="name"/><field name="date"/><field name="carrier_id"/>
                <field name="shipment_ids" widget="many2many_tags"/><field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_mb_carrier_manifest_form" model="ir.ui.view">
        <field name="name">mb.carrier.manifest.form</field>
        <field name="model">mb.carrier.manifest</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_ready" type="object" string="Print local worksheet" class="btn-primary" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert">This is a local handover worksheet, not a carrier-accepted manifest.</div>
                    <h1><field name="name"/></h1>
                    <group><field name="company_id" groups="base.group_multi_company"/><field name="carrier_id"/><field name="date"/></group>
                    <field name="shipment_ids" domain="[('company_id','=',company_id),('carrier_id','=',carrier_id),('direction','=','outbound'),('state','=','label_ready')]">
                        <list><field name="picking_id"/><field name="tracking_number"/><field name="provider_ref"/><field name="state"/></list>
                    </field>
                    <group invisible="not provider_ref"><field name="provider_ref"/><field name="document_id"/></group>
                    <field name="last_error" invisible="not last_error"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_mb_carrier_manifests" model="ir.actions.act_window">
        <field name="name">Handover Worksheets</field><field name="res_model">mb.carrier.manifest</field><field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_mb_carrier_manifests" name="Handover Worksheets" parent="stock.menu_stock_root" action="action_mb_carrier_manifests" groups="stock.group_stock_user" sequence="71"/>
</odoo>
