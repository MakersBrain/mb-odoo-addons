<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="shipment_company_rule" model="ir.rule">
        <field name="name">Carrier shipments by company</field>
        <field name="model_id" ref="model_mb_carrier_shipment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="pickup_point_company_rule" model="ir.rule">
