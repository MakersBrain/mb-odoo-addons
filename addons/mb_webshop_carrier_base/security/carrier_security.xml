        <field name="model_id" ref="model_mb_carrier_request_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="manifest_company_rule" model="ir.rule">
        <field name="name">Carrier manifests by company</field>
        <field name="model_id" ref="model_mb_carrier_manifest"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="webhook_event_company_rule" model="ir.rule">
        <field name="name">Carrier webhook inbox by company</field>
        <field name="model_id" ref="model_mb_carrier_webhook_event"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
