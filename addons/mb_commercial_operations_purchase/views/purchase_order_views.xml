<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_purchase_order_form_commercial_operation" model="ir.ui.view">
    <field name="name">purchase.order.form.commercial.operation</field>
    <field name="model">purchase.order</field>
    <field name="inherit_id" ref="purchase.purchase_order_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='origin']" position="after">
        <field name="mb_commercial_operation_id" readonly="state in ('purchase', 'done', 'cancel')"/>
      </xpath>
    </field>
  </record>
</odoo>
