<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_mb_depot_create_form" model="ir.ui.view">
    <field name="name">mb.depot.create.form</field>
    <field name="model">mb.depot.create</field>
    <field name="arch" type="xml">
      <form string="New depot">
        <p class="text-muted">
          Creates the depot's warehouse and its commission pricelist. Pieces
          placed there stay on your books until the depositary reports them
          sold, and a sale is made by putting this depot in the Warehouse field
          of the quotation.
        </p>
        <group>
          <field name="partner_id"/>
          <field name="code"/>
          <field name="commission"/>
          <field name="legal_structure"/>
          <field name="assign_pricelist"/>
        </group>
        <footer>
          <button name="action_create" type="object" string="Create depot"
                  class="btn-primary"/>
          <button special="cancel" string="Cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_mb_depot_create" model="ir.actions.act_window">
    <field name="name">New depot</field>
    <field name="res_model">mb.depot.create</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>

</odoo>
