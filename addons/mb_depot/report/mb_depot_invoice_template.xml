<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="report_invoice_document_mb_depot" inherit_id="account.report_invoice_document">
    <xpath expr="//div[@id='informations']" position="inside">
      <div class="col" t-if="o.mb_depot_sale_report_ids" name="depot_sale_report_reference">
        <strong t-if="len(o.mb_depot_sale_report_ids) &gt; 1">Depot reports</strong>
        <strong t-else="">Depot report</strong>
        <div t-out="', '.join(o.mb_depot_sale_report_ids.mapped('external_reference'))"/>
      </div>
      <div class="col" t-if="o.mb_depot_delivery_date_from" name="depot_delivery_period">
        <strong>Delivery period</strong>
        <div>
          <span t-field="o.mb_depot_delivery_date_from"/>
          <t t-if="o.mb_depot_delivery_date_to != o.mb_depot_delivery_date_from">
            – <span t-field="o.mb_depot_delivery_date_to"/>
          </t>
        </div>
      </div>
    </xpath>
  </template>
</odoo>
