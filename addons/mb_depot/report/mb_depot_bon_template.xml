<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <template id="report_bon_depot_document">
    <t t-call="web.external_layout">
      <t t-set="depot" t-value="doc.depot_warehouse_id"/>
      <t t-set="partner" t-value="depot.depot_partner_id"/>
      <t t-set="currency" t-value="doc.company_id.currency_id"/>
      <t t-set="lines" t-value="doc.move_line_ids.filtered(lambda l: l.quantity)"/>
      <t t-set="total" t-value="sum(l.product_id.list_price * l.quantity for l in lines)"/>
      <div class="page">

        <div class="d-flex justify-content-between align-items-end border-bottom pb-2 mb-4">
          <div>
            <h2 class="mb-0">
              <t t-if="doc.is_depot_placement">Consignment Note</t>
              <t t-else="">Return Note</t>
            </h2>
            <span class="text-muted">Consignment</span>
          </div>
          <div class="text-end">
            <div class="fs-4 fw-bold"><span t-field="doc.name"/></div>
            <div class="text-muted">
              <span t-field="doc.date_done" t-options='{"widget": "date"}'/>
              <t t-if="not doc.date_done">
                <span t-field="doc.scheduled_date" t-options='{"widget": "date"}'/>
                <span> (planned)</span>
              </t>
            </div>
          </div>
        </div>

        <div class="row mb-4">
          <div class="col-6">
            <div class="text-muted text-uppercase small fw-bold mb-1">Consignor</div>
            <div class="fw-bold"><span t-field="doc.company_id.partner_id.name"/></div>
            <div t-field="doc.company_id.partner_id"
                 t-options='{"widget": "contact", "fields": ["address", "phone", "email"], "no_marker": true}'/>
          </div>
          <div class="col-6">
            <div class="text-muted text-uppercase small fw-bold mb-1">Consignee</div>
            <div class="fw-bold"><span t-field="partner.name"/></div>
            <div t-if="partner" t-field="depot.depot_partner_id"
                 t-options='{"widget": "contact", "fields": ["address", "phone", "email"], "no_marker": true}'/>
          </div>
        </div>

        <div class="row mb-4">
          <div class="col-4">
            <div class="text-muted small">Depot location</div>
            <div><span t-field="depot.name"/></div>
          </div>
          <div class="col-4">
            <div class="text-muted small">Commission</div>
            <div>
              <t t-if="depot.depot_commission" t-translation="off">
                <span t-out="'%g' % depot.depot_commission"/><span> %</span>
              </t>
              <t t-else="" t-translation="off">—</t>
            </div>
          </div>
          <div class="col-4">
            <div class="text-muted small">Pieces</div>
            <div><span t-out="int(sum(lines.mapped('quantity')))"/></div>
          </div>
        </div>

        <table class="table table-sm o_main_table" style="table-layout:fixed; width:99%;">
          <thead>
            <tr>
              <th class="text-start" style="width:5%;">#</th>
              <th class="text-start" style="width:33%;">Piece</th>
              <th class="text-start" style="width:20%;">Serial number</th>
              <th class="text-end" style="width:12%;">Qty</th>
              <th class="text-end" style="width:15%;">Retail price</th>
              <th class="text-end" style="width:15%;">Total</th>
            </tr>
          </thead>
          <tbody>
            <tr t-foreach="lines" t-as="ml">
              <td class="text-start text-muted"><span t-out="ml_index + 1"/></td>
              <td class="text-start">
                <span t-field="ml.product_id.display_name"/>
              </td>
              <td class="text-start">
                <span t-field="ml.lot_id.name"/>
                <t t-if="not ml.lot_id" t-translation="off"><span class="text-muted">—</span></t>
              </td>
              <!-- nowrap: the quantity and its unit wrapping onto two lines is
                   what pushes a long placement onto a second page. -->
              <td class="text-end" style="white-space:nowrap;">
                <span t-field="ml.quantity"/>
                <span t-field="ml.product_uom_id" groups="uom.group_uom"/>
              </td>
              <td class="text-end">
                <span t-out="ml.product_id.list_price"
                      t-options='{"widget": "monetary", "display_currency": currency}'/>
              </td>
              <td class="text-end">
                <span t-out="ml.product_id.list_price * ml.quantity"
                      t-options='{"widget": "monetary", "display_currency": currency}'/>
              </td>
            </tr>
          </tbody>
        </table>

        <div class="row justify-content-end mb-4">
          <div class="col-5">
            <table class="table table-sm" style="width:99%;">
              <tr class="border-black o_total">
                <td><strong>Total retail price</strong></td>
                <td class="text-end">
                  <strong>
                    <span t-out="total"
                          t-options='{"widget": "monetary", "display_currency": currency}'/>
                  </strong>
                </td>
              </tr>
              <tr t-if="depot.depot_commission">
                <td class="text-muted">Consignee commission<t t-translation="off"> (<span t-out="'%g' % depot.depot_commission"/> %)</t></td>
                <td class="text-end text-muted">
                  <span t-out="total * depot.depot_commission / 100.0"
                        t-options='{"widget": "monetary", "display_currency": currency}'/>
                </td>
              </tr>
              <tr t-if="depot.depot_commission">
                <td class="text-muted">Consignor net if fully sold</td>
                <td class="text-end text-muted">
                  <span t-out="total * (100.0 - depot.depot_commission) / 100.0"
                        t-options='{"widget": "monetary", "display_currency": currency}'/>
                </td>
              </tr>
            </table>
          </div>
        </div>

        <!-- The terms and the signatures are one block: a bon whose signature
             lines land on a page of their own, away from what was signed for,
             is not worth handing to a gallery. -->
        <div style="page-break-inside:avoid;">
        <div class="border-top pt-2 mb-4">
          <p class="text-muted small mb-0">
            <t t-if="doc.is_depot_placement">
              Pieces entrusted on consignment. They remain the property of the
              consignor until they are sold to the public by the consignee, who has
              custody of them and answers for their loss or damage. The consignee
              records the sales made and reports them to the consignor, who invoices
              each piece sold at the retail price less the commission above. Unsold
              pieces are returned on request. The total above is indicative and does
              not constitute an invoice.
            </t>
            <t t-else="">
              Pieces taken back from the depot and returned to the consignor. This
              note closes the consignee's custody of those pieces. The total above is
              indicative and does not constitute an invoice.
            </t>
          </p>
        </div>

        <div class="row mt-4">
          <div class="col-6">
            <div class="text-muted text-uppercase small fw-bold">The consignor</div>
            <div class="text-muted small">Name, date and signature</div>
            <div style="height:70px;"/>
            <div class="border-top"/>
          </div>
          <div class="col-6">
            <div class="text-muted text-uppercase small fw-bold">The consignee</div>
            <div class="text-muted small">Name, date and signature, preceded by "Read and approved"</div>
            <div style="height:70px;"/>
            <div class="border-top"/>
          </div>
        </div>
        </div>

      </div>
    </t>
  </template>

  <template id="report_bon_depot">
    <t t-call="web.html_container">
      <t t-foreach="docs" t-as="doc">
        <t t-call="mb_depot.report_bon_depot_document"/>
      </t>
    </t>
  </template>

</odoo>
