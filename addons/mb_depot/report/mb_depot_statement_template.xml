<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <template id="report_depot_statement_document">
    <t t-call="web.external_layout">
      <div class="page">
        <h2>Consignment Statement</h2>
        <div class="row mb-4">
          <div class="col-6">
            <strong>Consignee</strong><br/>
            <span t-field="doc.partner_id"/><br/>
            <span t-field="doc.depot_id.name"/>
          </div>
          <div class="col-6">
            <strong>Period</strong><br/>
            <t t-translation="off"><span t-field="doc.date_from"/> - <span t-field="doc.date_to"/></t>
          </div>
        </div>

        <table class="table table-sm">
          <thead>
            <tr>
              <th>Piece</th>
              <th>Serial number</th>
              <th class="text-end">Opening</th>
              <th class="text-end">Placed</th>
              <th class="text-end">Sold</th>
              <th>Sold on</th>
              <th class="text-end">Returned</th>
              <th class="text-end">On consignment</th>
              <th class="text-end">Retail price</th>
              <th class="text-end">Commission</th>
              <th class="text-end">Net</th>
            </tr>
          </thead>
          <tbody>
            <tr t-foreach="doc.line_ids" t-as="line">
              <td><span t-field="line.product_id"/></td>
              <td><span t-field="line.lot_name"/></td>
              <td class="text-end"><span t-field="line.qty_opening"/></td>
              <td class="text-end"><span t-field="line.qty_placed"/></td>
              <td class="text-end"><span t-field="line.qty_sold"/></td>
              <td><span t-field="line.date_sold"/></td>
              <td class="text-end"><span t-field="line.qty_returned"/></td>
              <td class="text-end"><strong><span t-field="line.qty_closing"/></strong></td>
              <td class="text-end">
                <span t-field="line.amount_gross"
                      t-options='{"widget": "monetary", "display_currency": line.currency_id}'/>
              </td>
              <td class="text-end">
                <span t-field="line.amount_commission"
                      t-options='{"widget": "monetary", "display_currency": line.currency_id}'/>
              </td>
              <td class="text-end">
                <span t-field="line.amount_net"
                      t-options='{"widget": "monetary", "display_currency": line.currency_id}'/>
              </td>
            </tr>
          </tbody>
        </table>

        <div class="row justify-content-end">
          <div class="col-5">
            <table class="table table-sm">
              <tr>
                <td>Total retail price</td>
                <td class="text-end">
                  <span t-field="doc.total_gross"
                        t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                </td>
              </tr>
              <tr>
                <td>Consignee commission</td>
                <td class="text-end">
                  <span t-field="doc.total_commission"
                        t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                </td>
              </tr>
              <tr class="border-black">
                <td><strong>Net to invoice</strong></td>
                <td class="text-end">
                  <strong>
                    <span t-field="doc.total_sold"
                          t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                  </strong>
                </td>
              </tr>
            </table>
          </div>
        </div>

        <p class="text-muted mt-4">
          Pieces on consignment remain the property of the consignor until they are sold.
        </p>
      </div>
    </t>
  </template>

  <template id="report_depot_statement">
    <t t-call="web.html_container">
      <t t-foreach="docs" t-as="doc">
        <t t-call="mb_depot.report_depot_statement_document"/>
      </t>
    </t>
  </template>

</odoo>
