<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_company_form_mb_depot_closing" model="ir.ui.view">
    <field name="name">res.company.form.mb.depot.closing</field>
    <field name="model">res.company</field>
    <field name="inherit_id" ref="base.view_company_form"/>
    <field name="arch" type="xml">
      <xpath expr="//sheet" position="inside">
        <group string="Depot inventory closing" groups="account.group_account_manager">
          <field name="mb_depot_stock_closed_through"/>
        </group>
      </xpath>
    </field>
  </record>
</odoo>
