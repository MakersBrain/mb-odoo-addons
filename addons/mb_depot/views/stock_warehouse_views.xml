<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_warehouse_form_depot" model="ir.ui.view">
    <field name="name">stock.warehouse.form.depot</field>
    <field name="model">stock.warehouse</field>
    <field name="inherit_id" ref="stock.view_warehouse"/>
    <field name="arch" type="xml">
      <xpath expr="//group" position="inside">
        <group string="Dépôt-vente">
          <field name="is_depot"/>
          <field name="mb_depot_legal_structure" invisible="not is_depot"
                 required="is_depot"/>
          <field name="depot_partner_id" invisible="not is_depot"
                 required="is_depot"/>
          <field name="depot_commission" invisible="not is_depot"/>
          <field name="depot_pricelist_id" invisible="not is_depot" readonly="1"/>
          <field name="depot_qty" invisible="not is_depot" readonly="1"/>
          <field name="mb_depot_mandate_reviewed_through"
                 invisible="mb_depot_legal_structure != 'mandate'"
                 groups="account.group_account_manager"/>
          <field name="mb_depot_mandate_review_note"
                 invisible="mb_depot_legal_structure != 'mandate'"
                 groups="account.group_account_manager"/>
        </group>
      </xpath>
    </field>
  </record>

  <record id="view_depot_list" model="ir.ui.view">
    <field name="name">stock.warehouse.list.depot</field>
    <field name="model">stock.warehouse</field>
    <field name="arch" type="xml">
      <list string="Dépôts">
        <field name="name" string="Depot"/>
        <field name="code" string="Short name"/>
        <field name="depot_partner_id"/>
        <field name="depot_commission" widget="percentage" optional="show"/>
        <field name="depot_qty"/>
        <field name="depot_pricelist_id" optional="hide"/>
      </list>
    </field>
  </record>

  <record id="action_depot" model="ir.actions.act_window">
    <field name="name">Dépôts</field>
    <field name="res_model">stock.warehouse</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('is_depot', '=', True)]</field>
    <field name="view_id" ref="view_depot_list"/>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Create a dépôt-vente</p>
      <p>A depot is a warehouse someone else holds. Its stock stays internal, so
         unsold pieces stay on our books until the depositary reports a sale.
         Use <b>New depot</b> rather than creating the warehouse by hand: a depot
         is a warehouse and a commission pricelist, and they have to agree with
         each other.</p>
    </field>
  </record>

</odoo>
