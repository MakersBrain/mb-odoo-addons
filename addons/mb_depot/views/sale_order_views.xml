<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_order_form_depot" model="ir.ui.view">
    <field name="name">sale.order.form.depot</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="arch" type="xml">

      <!-- The domains below read these off the row, so both have to be in the
           list even though neither is ever shown. There is no depot field of
           our own on the order any more: a depot is a warehouse, so Odoo's own
           Warehouse field is what selects one, and selecting it is what sources
           the delivery from the gallery. -->
      <xpath expr="//field[@name='order_line']/list/field[@name='product_template_id']"
             position="before">
        <field name="mb_is_depot_order" column_invisible="True"/>
        <field name="mb_depot_product_ids" column_invisible="True"/>
      </xpath>

      <!-- Restricting the picker rather than warning after the fact: a piece
           that is not at the gallery cannot be sold by the gallery, and the
           standard clauses are kept because replacing the domain drops them.
           On Hand and Forecasted need no help here - they are warehouse-scoped
           and the warehouse is now the depot. -->
      <xpath expr="//field[@name='order_line']/list/field[@name='product_template_id']"
             position="attributes">
        <attribute name="domain">[('sale_ok', '=', True), '|', ('company_id', '=', False), ('company_id', '=', company_id)] + (mb_is_depot_order and [('product_variant_ids', 'in', mb_depot_product_ids)] or [])</attribute>
      </xpath>

      <xpath expr="//field[@name='order_line']/list/field[@name='product_id']"
             position="attributes">
        <attribute name="domain">[('sale_ok', '=', True), '|', ('company_id', '=', False), ('company_id', '=', company_id)] + (mb_is_depot_order and [('id', 'in', mb_depot_product_ids)] or [])</attribute>
      </xpath>

      <xpath expr="//field[@name='client_order_ref']" position="after">
        <field name="mb_depot_sale_report_id" readonly="1" invisible="not mb_depot_sale_report_id"/>
        <field name="mb_depot_effective_date" readonly="1" invisible="not mb_depot_sale_report_id"/>
        <field name="mb_depot_reported_public_total" readonly="1" invisible="not mb_depot_sale_report_id"/>
        <field name="mb_depot_reported_net_total" readonly="1" invisible="not mb_depot_sale_report_id"/>
      </xpath>

    </field>
  </record>

</odoo>
