<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_depot_quant_list" model="ir.ui.view">
    <field name="name">stock.quant.list.depot</field>
    <field name="model">stock.quant</field>
    <field name="arch" type="xml">
      <list string="Stock en dépôt" create="false" edit="false">
        <field name="location_id" string="Depot"/>
        <field name="depot_partner_id" optional="show"/>
        <field name="product_id"/>
        <field name="lot_id" string="Serial"/>
        <field name="quantity" string="On hand"/>
        <field name="reserved_quantity" string="Reserved" optional="show"/>
        <field name="in_date" string="Placed"/>
        <field name="depot_days" string="Days held"
               decoration-warning="depot_days &gt; 90"
               decoration-danger="depot_days &gt; 180"/>
      </list>
    </field>
  </record>

  <record id="view_depot_quant_search" model="ir.ui.view">
    <field name="name">stock.quant.search.depot</field>
    <field name="model">stock.quant</field>
    <field name="arch" type="xml">
      <search string="Stock en dépôt">
        <field name="product_id"/>
        <field name="lot_id"/>
        <field name="location_id" string="Depot"/>
        <field name="depot_partner_id"/>
        <group>
          <filter name="aged_90" string="Held over 90 days"
                  domain="[('in_date', '&lt;', (context_today() - datetime.timedelta(days=90)).strftime('%Y-%m-%d'))]"/>
          <filter name="aged_180" string="Held over 180 days"
                  domain="[('in_date', '&lt;', (context_today() - datetime.timedelta(days=180)).strftime('%Y-%m-%d'))]"/>
          <separator/>
          <filter name="unreserved" string="Not reserved"
                  domain="[('reserved_quantity', '=', 0)]"/>
        </group>
        <group>
          <filter name="group_depot" string="Depot" context="{'group_by': 'location_id'}"/>
          <filter name="group_partner" string="Depositary"
                  context="{'group_by': 'depot_partner_id'}"/>
          <filter name="group_product" string="Piece" context="{'group_by': 'product_id'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_depot_quant" model="ir.actions.act_window">
    <field name="name">Stock en dépôt</field>
    <field name="res_model">stock.quant</field>
    <field name="view_mode">list</field>
    <field name="domain">[('location_id.warehouse_id.is_depot', '=', True)]</field>
    <field name="context">{'search_default_group_depot': 1}</field>
    <field name="view_id" ref="view_depot_quant_list"/>
    <field name="search_view_id" ref="view_depot_quant_search"/>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Nothing is out on consignment</p>
      <p>Place pieces at a depot with an internal transfer to its location.
         They stay ours and on our books until the depositary reports a sale.</p>
    </field>
  </record>

</odoo>
