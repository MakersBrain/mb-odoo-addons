<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="res_groups_privilege_depot_sales" model="res.groups.privilege">
    <field name="name">Depot Sales</field>
    <field name="sequence">25</field>
    <field name="category_id" ref="base.module_category_supply_chain"/>
  </record>

  <record id="group_depot_sale_manager" model="res.groups">
    <field name="name">Manager</field>
    <field name="sequence">10</field>
    <field name="privilege_id" ref="res_groups_privilege_depot_sales"/>
    <field name="implied_ids" eval="[(4, ref('stock.group_stock_user')), (4, ref('sales_team.group_sale_salesman'))]"/>
    <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
  </record>

  <record id="rule_mb_depot_sale_report_company" model="ir.rule">
    <field name="name">Depot sale reports by company</field>
    <field name="model_id" ref="model_mb_depot_sale_report"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    <field name="groups" eval="[(4, ref('group_depot_sale_manager'))]"/>
  </record>

  <record id="rule_mb_depot_sale_report_line_company" model="ir.rule">
    <field name="name">Depot sale report lines by company</field>
    <field name="model_id" ref="model_mb_depot_sale_report_line"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    <field name="groups" eval="[(4, ref('group_depot_sale_manager'))]"/>
  </record>
</odoo>
