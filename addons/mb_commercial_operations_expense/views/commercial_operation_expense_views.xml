<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_commercial_operation_form_expense" model="ir.ui.view">
    <field name="name">mb.commercial.operation.form.expense</field>
    <field name="model">mb.commercial.operation</field>
    <field name="inherit_id" ref="mb_commercial_operations.view_commercial_operation_form"/>
    <field name="arch" type="xml">
      <xpath expr="//div[@name='button_box']" position="inside">
        <button class="oe_stat_button" type="object" name="action_view_expenses" icon="fa-credit-card">
          <span>Expenses</span>
        </button>
      </xpath>
      <xpath expr="//field[@name='documents_expected']" position="after">
        <field name="expenses_expected" readonly="state == 'financially_closed'"/>
        <field name="expenses_complete" readonly="1"/>
      </xpath>
    </field>
  </record>
</odoo>
