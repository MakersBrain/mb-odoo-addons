<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="hr_expense_view_form_commercial_operation" model="ir.ui.view">
    <field name="name">hr.expense.form.commercial.operation</field>
    <field name="model">hr.expense</field>
    <field name="inherit_id" ref="hr_expense.hr_expense_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='date']" position="after">
        <field name="mb_commercial_operation_id" readonly="state not in ('draft', 'submitted')"/>
      </xpath>
    </field>
  </record>
</odoo>
