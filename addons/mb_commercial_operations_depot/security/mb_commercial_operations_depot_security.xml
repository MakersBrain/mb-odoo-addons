<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="rule_depot_assortment_company" model="ir.rule">
    <field name="name">Depot assortment rules by company</field>
    <field name="model_id" ref="model_mb_depot_assortment_rule"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    <field name="groups" eval="[(4, ref('mb_commercial_operations.group_commercial_operations_user'))]"/>
  </record>
  <record id="rule_depot_forecast_company" model="ir.rule">
    <field name="name">Depot refill forecasts by company</field>
    <field name="model_id" ref="model_mb_depot_refill_forecast"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    <field name="groups" eval="[(4, ref('mb_commercial_operations.group_commercial_operations_user'))]"/>
  </record>
  <record id="rule_commercial_rent_period_company" model="ir.rule">
    <field name="name">Commercial rent periods by company</field>
    <field name="model_id" ref="model_mb_commercial_rent_period"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    <field name="groups" eval="[(4, ref('mb_commercial_operations.group_commercial_operations_user'))]"/>
  </record>
  <record id="rule_depot_scenario_company" model="ir.rule">
    <field name="name">Depot profitability scenarios by company</field>
    <field name="model_id" ref="model_mb_depot_profitability_scenario"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    <field name="groups" eval="[(4, ref('mb_commercial_operations.group_commercial_operations_user'))]"/>
  </record>
</odoo>
