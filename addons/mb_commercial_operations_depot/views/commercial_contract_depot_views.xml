<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_commercial_contract_form_depot" model="ir.ui.view">
    <field name="name">mb.commercial.contract.form.depot</field>
    <field name="model">mb.commercial.contract</field>
    <field name="inherit_id" ref="mb_commercial_operations.view_commercial_contract_form"/>
    <field name="arch" type="xml">
      <xpath expr="//header" position="inside">
        <button name="action_refresh_depot_forecast" type="object" string="Refresh Forecast"
                invisible="not depot_warehouse_id"/>
        <button name="action_create_refill_operation" type="object" string="Plan Refill" class="btn-primary"
                invisible="not depot_warehouse_id"/>
        <button name="action_prepare_rent_bill" type="object" string="Prepare Rent Bill"
                groups="account.group_account_invoice"
                invisible="rent_billing_method != 'vendor_bill' or not monthly_fixed_rent"/>
      </xpath>
      <xpath expr="//field[@name='origin_partner_id']" position="after">
        <field name="depot_warehouse_id"/>
        <field name="source_warehouse_id"/>
        <field name="refill_review_date"/>
      </xpath>
      <xpath expr="//field[@name='rent_product_id']" position="after">
        <field name="rent_period_to_prepare" invisible="rent_billing_method != 'vendor_bill'"/>
      </xpath>
      <xpath expr="//notebook" position="inside">
        <page string="Depot Refill Policy" invisible="not depot_warehouse_id">
          <field name="assortment_rule_ids">
            <list editable="bottom">
              <field name="priority" widget="handle"/>
              <field name="name"/>
              <field name="target_type"/>
              <field name="product_id" invisible="target_type != 'product'"/>
              <field name="category_id" invisible="target_type != 'bucket'"/>
              <field name="price_min" invisible="target_type != 'bucket'"/>
              <field name="price_max" invisible="target_type != 'bucket'"/>
              <field name="minimum_quantity"/>
              <field name="target_quantity"/>
              <field name="demand_window_days"/>
              <field name="target_days"/>
              <field name="active"/>
              <field name="currency_id" column_invisible="True"/>
            </list>
          </field>
        </page>
        <page string="Rent Evidence" invisible="not depot_warehouse_id">
          <field name="rent_period_ids" readonly="1">
            <list>
              <field name="period_start"/>
              <field name="period_end"/>
              <field name="active_days"/>
              <field name="amount" sum="Total"/>
              <field name="bill_id"/>
              <field name="state" widget="badge"/>
              <field name="currency_id" column_invisible="True"/>
            </list>
          </field>
        </page>
      </xpath>
    </field>
  </record>
</odoo>
