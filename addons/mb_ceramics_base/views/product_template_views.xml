<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_template_form_view_mb_ceramics" model="ir.ui.view">
        <field name="name">product.template.form.mb.ceramics</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']//group" position="after">
                <group string="Ceramics" name="mb_ceramics">
                    <field name="mb_clay_body_id" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
