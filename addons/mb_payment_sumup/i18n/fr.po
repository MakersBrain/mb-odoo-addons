#. odoo-python
#: code:addons/mb_payment_sumup/models/payment_transaction.py:0
msgid "A completed SumUp checkout cannot be replaced."
msgstr "Un paiement SumUp déjà finalisé ne peut pas être remplacé."

#. module: mb_payment_sumup
#: model:ir.model.fields,field_description:mb_payment_sumup.field_payment_provider__code
msgid "Code"
msgstr "Code"

#. module: mb_payment_sumup
#: model:ir.model.fields,help:mb_payment_sumup.field_payment_transaction__sumup_refund_target_amount
msgid ""
"Cumulative successful refund amount that SumUp must report before this "
"refund transaction may be completed."
msgstr ""
"Montant cumulé des remboursements réussis que SumUp doit avoir enregistré "
"avant que cette transaction de remboursement puisse être finalisée."

#. module: mb_payment_sumup
#: model:ir.model.fields,field_description:mb_payment_sumup.field_payment_provider__display_name
#: model:ir.model.fields,field_description:mb_payment_sumup.field_payment_transaction__display_name
msgid "Display Name"
msgstr "Nom d'affichage"

#. module: mb_payment_sumup
#: model:ir.model.fields,field_description:mb_payment_sumup.field_payment_provider__id
#: model:ir.model.fields,field_description:mb_payment_sumup.field_payment_transaction__id
msgid "ID"
msgstr "ID"

#. module: mb_payment_sumup
#: model_terms:ir.ui.view,arch_db:mb_payment_sumup.payment_provider_form
msgid "Merchant Code"
msgstr "Code marchand"

#. module: mb_payment_sumup
#. odoo-python
#: code:addons/mb_payment_sumup/models/payment_provider.py:0
msgid ""
"No SumUp merchant code is set on the provider %s. No payment can be taken "
"until it is, because the merchant code is what decides which account "
"receives the money."
msgstr ""
"Aucun code marchand SumUp n'est renseigné sur le fournisseur %s. Aucun "
"paiement ne peut être encaissé tant qu'il manque, car le code marchand "
"détermine le compte qui reçoit l'argent."

#. module: mb_payment_sumup
#: model:ir.model,name:mb_payment_sumup.model_payment_provider
msgid "Payment Provider"
msgstr "Fournisseur de paiement"

#. module: mb_payment_sumup
#: model:ir.model,name:mb_payment_sumup.model_payment_transaction
msgid "Payment Transaction"
msgstr "Transaction de paiement"

#. module: mb_payment_sumup
#. odoo-python
#: code:addons/mb_payment_sumup/models/payment_transaction.py:0
msgid "Received data with invalid checkout status: %s."
msgstr "Données reçues avec un statut de paiement invalide : %s."

#. module: mb_payment_sumup
#: model_terms:ir.ui.view,arch_db:mb_payment_sumup.payment_provider_form
msgid "Secret Key"
msgstr "Clé secrète"

