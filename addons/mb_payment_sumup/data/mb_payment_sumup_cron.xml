<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Not `noupdate`: the schedule is ours to change on upgrade, and nobody
         is expected to tune it by hand. -->
    <record model="ir.cron" id="cron_poll_sumup_checkouts">
        <field name="name">SumUp: Poll pending checkouts</field>
        <field name="model_id" ref="payment.model_payment_transaction"/>
        <field name="state">code</field>
        <field name="code">model._cron_poll_sumup_checkouts()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

</odoo>
