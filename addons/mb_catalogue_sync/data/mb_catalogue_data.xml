<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- The material taxonomy moved to mb_workshop_base in 19.0.1.3.0; this addon
       maps catalogue families onto it rather than owning it. See
       mb_workshop_base/data/mb_material_categories.xml for why. -->

  <!-- The pack size an artisan buys, as a product attribute.

       'always' rather than 'dynamic': the packs come from the catalogue and are
       known at import, and an always-variant is the one a purchase order line
       and a stock move can point at without Odoo creating it mid-transaction. -->
  <record id="attribute_pack_size" model="product.attribute">
    <field name="name">Pack size</field>
    <field name="create_variant">always</field>
    <field name="display_type">radio</field>
    <field name="sequence">10</field>
  </record>
</odoo>
