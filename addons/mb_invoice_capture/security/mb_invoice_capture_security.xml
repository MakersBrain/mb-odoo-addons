<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="rule_mb_invoice_capture_company" model="ir.rule">
        <field name="name">Captured invoices stay in the active companies</field>
        <field name="model_id" ref="model_mb_invoice_capture"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_mb_invoice_capture_line_company" model="ir.rule">
        <field name="name">Captured invoice lines stay in the active companies</field>
        <field name="model_id" ref="model_mb_invoice_capture_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
