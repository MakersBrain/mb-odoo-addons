<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="mb_firing_load_view_form" model="ir.ui.view">
        <field name="name">mb.firing.load.form</field>
        <field name="model">mb.firing.load</field>
        <field name="arch" type="xml">
            <form string="Load kiln">
                <group>
                    <field name="firing_id" />
                    <field name="board_ids" widget="many2many_tags" />
                    <field name="eligible_workorder_ids" invisible="1" />
                    <field name="workorder_ids" widget="many2many_tags"
                           domain="[('id', 'in', eligible_workorder_ids)]" />
                </group>
                <footer>
                    <button name="action_load" type="object" string="Load"
                            class="btn-primary" />
                    <button string="Cancel" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
    <record id="mb_firing_form_workflow" model="ir.ui.view">
        <field name="name">mb.firing.form.workflow</field>
        <field name="model">mb.firing</field>
        <field name="inherit_id" ref="mb_ceramics_firing.mb_firing_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_mb_load" type="object" string="Load ware"
                        invisible="state != 'draft'" />
            </xpath>
        </field>
    </record>
</odoo>
