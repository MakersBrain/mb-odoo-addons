<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="mb_production_loss_view_list" model="ir.ui.view">
        <field name="name">mb.production.loss.list</field>
        <field name="model">mb.production.loss</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" edit="0">
                <field name="date" />
                <field name="production_id" />
                <field name="product_id" />
                <field name="quantity" />
                <field name="operation_id" />
                <field name="board_id" />
                <field name="firing_id" />
                <field name="reason" />
                <field name="user_id" />
            </list>
        </field>
    </record>
    <record id="mb_production_loss_action" model="ir.actions.act_window">
        <field name="name">Production losses</field>
        <field name="res_model">mb.production.loss</field>
        <field name="view_mode">list</field>
        <field name="context">{'create': False}</field>
    </record>
</odoo>
