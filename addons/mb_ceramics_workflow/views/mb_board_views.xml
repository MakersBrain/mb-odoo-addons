<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="mb_board_view_list" model="ir.ui.view">
        <field name="name">stock.package.ware.board.list</field>
        <field name="model">stock.package</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="location_id" />
                <field name="content_description" />
                <field name="mb_current_board_content_ids" widget="many2many_tags" />
            </list>
        </field>
    </record>
    <record id="mb_board_view_form" model="ir.ui.view">
        <field name="name">stock.package.ware.board.form</field>
        <field name="model">stock.package</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name" /></h1></div>
                    <group>
                        <field name="package_type_id" />
                        <field name="location_id" />
                        <field name="parent_package_id" />
                    </group>
                    <notebook>
                        <page string="Current WIP">
                            <field name="mb_current_board_content_ids" readonly="1">
                                <list>
                                    <field name="production_id" />
                                    <field name="product_id" />
                                    <field name="quantity" />
                                    <field name="current_workorder_id" />
                                    <field name="date_loaded" />
                                </list>
                            </field>
                        </page>
                        <page string="History">
                            <field name="mb_board_content_ids" readonly="1">
                                <list>
                                    <field name="production_id" />
                                    <field name="quantity" />
                                    <field name="state" />
                                    <field name="date_loaded" />
                                    <field name="date_unloaded" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="mb_board_action" model="ir.actions.act_window">
        <field name="name">Ware boards</field>
        <field name="res_model">stock.package</field>
        <field name="view_mode">list,form</field>
        <field name="domain" eval="[('package_type_id', '=', ref('mb_package_type_ware_board'))]" />
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('mb_board_view_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('mb_board_view_form')})]" />
        <field name="context" eval="{'default_package_type_id': ref('mb_package_type_ware_board')}" />
    </record>
</odoo>
