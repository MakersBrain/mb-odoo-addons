<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="ir_cron_mb_kiln_sync" model="ir.cron">
        <field name="name">Kiln bridge: import firings</field>
        <field name="model_id" ref="model_mb_kiln_connection" />
        <field name="state">code</field>
        <field name="code">model._cron_sync()</field>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <!-- A routine cron is intentionally always present and harmless when
             no configured connection exists. This is Odoo's standard polling
             shape and avoids a manager needing Scheduled Actions access. -->
        <field name="active" eval="True" />
    </record>

    <record id="ir_cron_mb_kiln_backfill" model="ir.cron">
        <field name="name">Kiln bridge: backfill history</field>
        <field name="model_id" ref="model_mb_kiln_connection" />
        <field name="state">code</field>
        <field name="code">model._cron_backfill()</field>
        <field name="interval_number">2</field>
        <field name="interval_type">minutes</field>
        <!-- Armed by the Backfill button and switched off by the job itself
             once every connection has finished. It is not a standing task. -->
        <field name="active" eval="False" />
    </record>
</odoo>
