<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_delivery_carrier_form_sendcloud" model="ir.ui.view">
        <field name="name">delivery.carrier.form.sendcloud</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='provider_details']" position="inside">
                <group string="Sendcloud" invisible="delivery_type != 'mb_sendcloud'">
                    <field name="mb_sendcloud_sender_address_id"/>
                    <field name="mb_sendcloud_contract_id"/>
                    <field name="mb_sendcloud_carrier_code"/>
                    <field name="mb_sendcloud_brand_id"/>
                    <field name="mb_sendcloud_use_locations"/>
                    <field name="mb_sendcloud_length_cm"/>
                    <field name="mb_sendcloud_width_cm"/>
                    <field name="mb_sendcloud_height_cm"/>
                    <field name="mb_sendcloud_content_description"/>
                    <field name="mb_sendcloud_webhook_ready" readonly="1"/>
                    <field name="mb_sendcloud_last_webhook_at" readonly="1"/>
                    <button name="action_mb_copy_sendcloud_webhook_url" type="object"
                            string="Show webhook URL" class="btn-secondary"
                            groups="base.group_system"
                            invisible="not mb_subscription_id"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
