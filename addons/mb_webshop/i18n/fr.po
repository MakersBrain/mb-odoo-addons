#. module: mb_webshop
#: model:mail.template,body_html:mb_webshop.mail_template_return_status
msgid ""
"<div style=\"margin: 0; padding: 0;\">\n"
"    <p style=\"margin: 0; padding: 0; font-size: 13px;\">\n"
"        Hello <t t-out=\"object.partner_id.name or ''\">Customer</t>,<br/><br/>\n"
"        <t t-if=\"object.state == 'requested'\">\n"
"            We received return request <strong t-out=\"object.name\">RET/2026/00001</strong>\n"
"            for order <strong t-out=\"object.order_id.name\">S00001</strong>.\n"
"            The workshop will review it before any items are sent back.\n"
"        </t>\n"
"        <t t-elif=\"object.state == 'approved'\">\n"
"            Your return <strong t-out=\"object.name\">RET/2026/00001</strong> was approved.\n"
"            The workshop will contact you with the return instructions.\n"
"        </t>\n"
"        <t t-elif=\"object.state == 'rejected'\">\n"
"            Your return <strong t-out=\"object.name\">RET/2026/00001</strong> could not be approved.\n"
"            <t t-if=\"object.decision_note\"><br/><span t-out=\"object.decision_note\"/></t>\n"
"        </t>\n"
"        <t t-elif=\"object.state == 'received'\">\n"
"            The workshop received the items for return <strong t-out=\"object.name\">RET/2026/00001</strong>.\n"
"        </t>\n"
"        <t t-elif=\"object.state == 'resolved'\">\n"
"            Return <strong t-out=\"object.name\">RET/2026/00001</strong> is complete.\n"
"        </t>\n"
"        <br/><br/>Thank you,<br/><t t-out=\"object.company_id.name or ''\">Workshop</t>\n"
"    </p>\n"
"</div>\n"
"        "
msgstr ""
"<div style=\"margin: 0; padding: 0;\">\n"
"    <p style=\"margin: 0; padding: 0; font-size: 13px;\">\n"
"        Bonjour <t t-out=\"object.partner_id.name or ''\">Client</t>,<br/><br/>\n"
"        <t t-if=\"object.state == 'requested'\">\n"
"            Nous avons reçu une demande de retour <strong t-out=\"object.name\">RET/2026/00001</strong>\n"
"            pour la commande <strong t-out=\"object.order_id.name\">S00001</strong>.\n"
"            L’atelier l’examinera avant que les articles ne soient renvoyés.\n"
"        </t>\n"
"        <t t-elif=\"object.state == 'approved'\">\n"
"            Votre retour <strong t-out=\"object.name\">RET/2026/00001</strong> a été approuvé.\n"
"            L'atelier vous contactera avec les instructions de retour.\n"
"        </t>\n"
"        <t t-elif=\"object.state == 'rejected'\">\n"
"            Votre retour <strong t-out=\"object.name\">RET/2026/00001</strong> n'a pas pu être approuvé.\n"
"            <t t-if=\"object.decision_note\"><br/><span t-out=\"object.decision_note\"/></t>\n"
"        </t>\n"
"        <t t-elif=\"object.state == 'received'\">\n"
"            L'atelier a reçu les articles à retourner <strong t-out=\"object.name\">RET/2026/00001</strong>.\n"
"        </t>\n"
"        <t t-elif=\"object.state == 'resolved'\">\n"
"            Le retour <strong t-out=\"object.name\">RET/2026/00001</strong> est terminé.\n"
"        </t>\n"
"        <br/><br/>Merci,<br/><t t-out=\"object.company_id.name or ''\">Atelier</t>\n"
"    </p>\n"
"</div>\n"
"        "

