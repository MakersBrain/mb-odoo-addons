<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.mb.webshop</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='website_info_settings']" position="inside">
                <setting id="mb_webshop_launch_readiness"
                         string="Webshop launch readiness"
                         help="Application configuration checks for the selected website.">
                    <field name="mb_ready_catalog" invisible="1"/>
                    <field name="mb_ready_online_payment" invisible="1"/>
                    <field name="mb_ready_fulfilment" invisible="1"/>
                    <field name="mb_ready_sender" invisible="1"/>
                    <field name="mb_ready_domain" invisible="1"/>
                    <field name="mb_ready_returns" invisible="1"/>
                    <field name="mb_launch_ready" invisible="1"/>
                    <field name="mb_ready_product_count" invisible="1"/>
                    <field name="mb_ready_payment_count" invisible="1"/>
                    <field name="mb_ready_fulfilment_count" invisible="1"/>
                    <div class="alert alert-success mb-3" role="status"
                         invisible="not mb_launch_ready">
                        Application configuration is ready for deployment qualification.
                    </div>
                    <div class="alert alert-warning mb-3" role="status"
                         invisible="mb_launch_ready">
                        Complete the items below before deployment qualification.
                    </div>
                    <div class="d-grid gap-2">
                        <div class="d-flex align-items-center justify-content-between">
                            <span>
                                <i class="fa fa-check-circle text-success me-1"
                                   invisible="not mb_ready_catalog"/>
                                <i class="fa fa-circle-o text-muted me-1"
                                   invisible="mb_ready_catalog"/>
                                Published catalogue
                                <span class="text-muted">
                                    (<field name="mb_ready_product_count" class="oe_inline"/> products)
                                </span>
                            </span>
                            <button name="action_mb_open_products" type="object"
                                    string="Products" class="btn-link"/>
                        </div>
                        <div class="d-flex align-items-center justify-content-between">
                            <span>
                                <i class="fa fa-check-circle text-success me-1"
                                   invisible="not mb_ready_online_payment"/>
                                <i class="fa fa-circle-o text-muted me-1"
                                   invisible="mb_ready_online_payment"/>
                                Production online payment
                                <span class="text-muted">
                                    (<field name="mb_ready_payment_count" class="oe_inline"/> providers)
                                </span>
                            </span>
                            <button name="action_mb_open_payment_providers" type="object"
                                    string="Payment providers" class="btn-link"/>
                        </div>
                        <div class="d-flex align-items-center justify-content-between">
                            <span>
                                <i class="fa fa-check-circle text-success me-1"
                                   invisible="not mb_ready_fulfilment"/>
                                <i class="fa fa-circle-o text-muted me-1"
                                   invisible="mb_ready_fulfilment"/>
                                Published shipping or collection
                                <span class="text-muted">
                                    (<field name="mb_ready_fulfilment_count" class="oe_inline"/> methods)
                                </span>
                            </span>
                            <button name="action_mb_open_delivery_methods" type="object"
                                    string="Delivery methods" class="btn-link"/>
                        </div>
                        <div class="d-flex align-items-center justify-content-between">
                            <span>
                                <i class="fa fa-check-circle text-success me-1"
                                   invisible="not mb_ready_sender"/>
                                <i class="fa fa-circle-o text-muted me-1"
                                   invisible="mb_ready_sender"/>
                                Company email and outgoing mail server
                            </span>
                            <button name="action_mb_open_mail_servers" type="object"
                                    string="Mail servers" class="btn-link"
                                    groups="base.group_system"/>
                        </div>
                        <div>
                            <i class="fa fa-check-circle text-success me-1"
                               invisible="not mb_ready_domain"/>
                            <i class="fa fa-circle-o text-muted me-1"
                               invisible="mb_ready_domain"/>
                            Public store URL assigned
                        </div>
                        <div>
                            <i class="fa fa-check-circle text-success me-1"
                               invisible="not mb_ready_returns"/>
                            <i class="fa fa-circle-o text-muted me-1"
                               invisible="mb_ready_returns"/>
                            Customer return window configured
                        </div>
                    </div>
                    <div class="text-muted mt-3">
                        Final qualification still verifies DNS, TLS, payment webhooks,
                        email deliverability, carrier credentials, and a live checkout.
                    </div>
                </setting>
                <setting id="mb_webshop_pack"
                         string="MakersBrain webshop pack"
                         help="The pack state is managed by your MakersBrain subscription.">
                    <field name="mb_webshop_enabled" readonly="1"/>
                    <div class="row mt8" invisible="not mb_webshop_enabled">
                        <label class="col-lg-4" for="mb_cart_hold_minutes"/>
                        <field name="mb_cart_hold_minutes" class="oe_inline"/>
                        <span class="ms-2">minutes</span>
                    </div>
                    <div class="row mt8" invisible="not mb_webshop_enabled">
                        <label class="col-lg-4" for="mb_return_window_days"/>
                        <field name="mb_return_window_days" class="oe_inline"/>
                        <span class="ms-2">days after delivery</span>
                    </div>
                    <div class="text-muted mt8">
                        Open the website editor and choose Theme to switch between the
                        Ceramics, Jewellery, and Woodwork presets or customize them.
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
