<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="stock_location_cart_holds" model="stock.location">
        <field name="name">Webshop cart holds</field>
        <field name="usage">transit</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="ir_cron_expire_stock_holds" model="ir.cron">
        <field name="name">Webshop: expire cart stock holds</field>
        <field name="model_id" ref="model_mb_webshop_stock_hold"/>
        <field name="state">code</field>
        <field name="code">model._expire_due()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
