<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="return_company_rule" model="ir.rule">
        <field name="name">Webshop returns: allowed companies</field>
        <field name="model_id" ref="model_mb_webshop_return"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_manager')), (4, ref('stock.group_stock_manager'))]"/>
    </record>
    <record id="return_line_company_rule" model="ir.rule">
        <field name="name">Webshop return lines: allowed companies</field>
        <field name="model_id" ref="model_mb_webshop_return_line"/>
        <field name="domain_force">[('return_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_manager')), (4, ref('stock.group_stock_manager'))]"/>
    </record>
    <record id="payment_exception_company_rule" model="ir.rule">
        <field name="name">Webshop payment exceptions: allowed companies</field>
        <field name="model_id" ref="model_mb_webshop_payment_exception"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
    </record>
</odoo>
