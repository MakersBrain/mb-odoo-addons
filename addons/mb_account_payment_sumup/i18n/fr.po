#. module: mb_account_payment_sumup
#: model:ir.model.fields,help:mb_account_payment_sumup.field_mb_sumup_link_wizard__destination
msgid ""
"SumUp: the customer pays on SumUp's own page, and never has to reach this "
"server. Customer portal: they land on the invoice here and choose how to "
"pay."
msgstr ""
"SumUp : le client paie sur la page de SumUp et n'a jamais besoin d'atteindre"
" ce serveur. Portail client : il arrive sur la facture ici et choisit son "
"moyen de paiement."

#. module: mb_account_payment_sumup
#. odoo-python
#: code:addons/mb_account_payment_sumup/models/account_move.py:0
msgid "The SumUp checkout amount cannot exceed the amount still due (%s)."
msgstr ""
"Le montant du paiement SumUp ne peut pas dépasser le montant restant dû "
"(%s)."

#. module: mb_account_payment_sumup
#: model:ir.model.fields,help:mb_account_payment_sumup.field_account_bank_statement_line__mb_sumup_checkout_url
#: model:ir.model.fields,help:mb_account_payment_sumup.field_account_move__mb_sumup_checkout_url
msgid ""
"The SumUp-hosted page that takes this payment. It is what a payment link "
"points at and what a QR code encodes."
msgstr ""
"La page hébergée par SumUp qui encaisse ce paiement. C'est la cible d'un "
"lien de paiement et le contenu d'un code QR."

#. module: mb_account_payment_sumup
#. odoo-python
#: code:addons/mb_account_payment_sumup/wizard/mb_sumup_link_wizard.py:0
msgid "The amount cannot exceed the %s still due on the invoice."
msgstr "Le montant ne peut pas dépasser les %s restant dus sur la facture."

#. module: mb_account_payment_sumup
#: model_terms:ir.ui.view,arch_db:mb_account_payment_sumup.mb_sumup_link_wizard_view_form
