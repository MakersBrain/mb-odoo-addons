<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_inherit_mb_sumup" model="ir.ui.view">
        <field name="name">account.move.form.inherit.sumup</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_mb_sumup_payment_link"
                        type="object"
                        string="Payment link"
                        invisible="move_type not in ('out_invoice', 'out_receipt')
                                   or state != 'posted'
                                   or payment_state in ('paid', 'in_payment', 'reversed')"/>
            </xpath>
            <xpath expr="//field[@name='payment_reference']" position="after">
                <field name="mb_sumup_checkout_url"
                       widget="url"
                       invisible="not mb_sumup_checkout_url"/>
            </xpath>
        </field>
    </record>

</odoo>
