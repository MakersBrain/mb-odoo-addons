# Provider credentials. POC-PLAN section 10.7 permits one development
# credential in a local ignored file and nowhere else - never in fixtures,
# addon data, logs, Git or ir.config_parameter.
*.env
!.env.example

# Database dumps and filestore archives. These carry real product, customer and
# accounting data, they are tens of megabytes each, and a repository is the
# wrong place for both of those reasons. Restore points live outside the tree.
backups/
*.dump
*.sql
*.tar.gz

__pycache__/
*.py[cod]
.direnv/
.venv/

# Editor and OS noise.
.idea/
.vscode/
*.swp
.DS_Store
