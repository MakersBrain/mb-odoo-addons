# Provider credentials. POC-PLAN section 10.7 permits one development
# credential in a local ignored file and nowhere else - never in fixtures,
# addon data, logs, Git or ir.config_parameter.
*.env
!.env.example

# Database dumps and filestore archives. These carry real product, customer and
# accounting data, they are tens of megabytes each, and a repository is the
# wrong place for both of those reasons. Restore points live outside the tree.
backups/
*.dump
*.sql
!control-plane/migrations/
!control-plane/migrations/*.sql
*.tar.gz

# Vendored OCA repositories. Upstream code, pinned and reproducible from
# tools/vendor-oca.sh, so committing it would only duplicate someone else's
# history. No addon here depends on one; see README.md.
oca/

__pycache__/
*.py[cod]
.direnv/
.venv/
.ruff_cache/

# Generated page. tools/build_landing.py inlines ~190 KB of base64 font into
# it, so committing it would put a quarter-megabyte diff in the history on
# every rebuild while adding nothing that is not already tracked. Every input
# is either in the tree (index.src.html) or in @makersbrain/brand, so a clean
# checkout rebuilds it offline with one command.
landing/index.html

# Editor and OS noise.
.idea/
.vscode/
*.swp
.DS_Store
